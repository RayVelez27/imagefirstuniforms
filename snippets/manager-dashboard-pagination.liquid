{%- comment -%}
  Manager Dashboard - Pagination
  Shared numbered pager (Previous, 1 … 4 5 6 … 20, Next) for the Orders and Users tabs.

  Usage (JS):
    renderDashboardPagination(navEl, page, totalPages, onPageChange)
  Hides navEl when there is only one page.
{%- endcomment -%}

<script>
  window.renderDashboardPagination = function(navEl, page, totalPages, onPageChange) {
    if (!navEl) return;

    if (totalPages <= 1) {
      navEl.hidden = true;
      navEl.innerHTML = '';
      return;
    }

    // First page, last page, and one page either side of the current page
    const pages = [1];
    const windowStart = Math.max(2, page - 1);
    const windowEnd = Math.min(totalPages - 1, page + 1);

    if (windowStart === 3) pages.push(2);
    else if (windowStart > 3) pages.push('gap');

    for (let p = windowStart; p <= windowEnd; p++) pages.push(p);

    if (windowEnd === totalPages - 2) pages.push(totalPages - 1);
    else if (windowEnd < totalPages - 2) pages.push('gap');

    pages.push(totalPages);

    const pageButtons = pages.map(p => {
      if (p === 'gap') {
        return '<span class="dashboard-pagination__gap" aria-hidden="true">&hellip;</span>';
      }
      const isCurrent = p === page;
      return `<button type="button" class="dashboard-pagination__btn${isCurrent ? ' is-active' : ''}" data-page="${p}"${isCurrent ? ' aria-current="page"' : ''} aria-label="Page ${p}">${p}</button>`;
    }).join('');

    navEl.innerHTML = `
      <button type="button" class="dashboard-pagination__btn dashboard-pagination__btn--step" data-page="${page - 1}"${page <= 1 ? ' disabled' : ''}>&lsaquo; Previous</button>
      ${pageButtons}
      <button type="button" class="dashboard-pagination__btn dashboard-pagination__btn--step" data-page="${page + 1}"${page >= totalPages ? ' disabled' : ''}>Next &rsaquo;</button>
    `;
    navEl.hidden = false;

    navEl.onclick = function(e) {
      const button = e.target.closest('button[data-page]');
      if (!button || button.disabled) return;
      const target = parseInt(button.dataset.page, 10);
      if (target !== page) onPageChange(target);
    };
  };
</script>

<style>
  .dashboard-pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
  }

  .dashboard-pagination[hidden] {
    display: none;
  }

  .dashboard-pagination__btn {
    min-width: 36px;
    height: 36px;
    padding: 0 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #fff;
    color: #333;
    font-size: 14px;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .dashboard-pagination__btn:hover:not(:disabled):not(.is-active) {
    border-color: #2563eb;
    color: #2563eb;
  }

  .dashboard-pagination__btn.is-active {
    background: #2563eb;
    border-color: #2563eb;
    color: #fff;
    cursor: default;
  }

  .dashboard-pagination__btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .dashboard-pagination__gap {
    padding: 0 4px;
    color: #999;
  }

  .dashboard-table.is-loading {
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  @media (max-width: 768px) {
    .dashboard-pagination__btn--step {
      flex-basis: calc(50% - 3px);
      order: 1;
    }
  }
</style>
