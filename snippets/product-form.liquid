{%- comment -%}
Size Chart Image Popup (replaces drawer/popover for belt and shirt size charts)
{%- endcomment -%}
{%- comment -%}Size chart popup is created dynamically on document.body via JS to escape drawer stacking context{%- endcomment -%}

<style>
  .size-chart-popup {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .size-chart-popup__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .size-chart-popup__content {
    position: relative;
    max-width: 900px;
    max-height: 90vh;
    width: 100%;
    background: white;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    overflow: auto;
  }

  .size-chart-popup__close {
    position: absolute;
    top: 10px;
    right: 14px;
    background: none;
    border: none;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    color: #333;
    z-index: 1;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background 0.2s;
  }

  .size-chart-popup__close:hover {
    background: rgba(0, 0, 0, 0.08);
  }

  .size-chart-popup__image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
  }

  @media (max-width: 600px) {
    .size-chart-popup__content {
      padding: 12px;
      border-radius: 8px;
    }

    .size-chart-popup__close {
      top: 6px;
      right: 8px;
    }
  }
</style>

<script>
  (function() {
    if (typeof window.SizeChartPopupInitialized !== 'undefined') return;
    window.SizeChartPopupInitialized = true;

    var sizeChartImages = {
      belt: 'https://cdn.shopify.com/s/files/1/0692/4130/7445/files/Nylon_Duty_Belt_Size_Chart_2.png?v=1770045416',
      shirt: 'https://cdn.shopify.com/s/files/1/0692/4130/7445/files/GFS_All_Polyester_Long_Sleeve_Shirt_Size_Chart_v2.png?v=1770653920',
      pants: 'https://cdn.shopify.com/s/files/1/0692/4130/7445/files/H-BDU-Trousers_Size_Chart_1.png?v=1773695380'
    };

    // Ensure there is always a single popup element on document.body so it escapes
    // drawer/popover stacking contexts (transform, overflow, etc.)
    function getOrCreateBodyPopup() {
      var popup = document.getElementById('size-chart-popup-body');
      if (!popup) {
        popup = document.createElement('div');
        popup.id = 'size-chart-popup-body';
        popup.className = 'size-chart-popup';
        popup.style.display = 'none';
        popup.innerHTML =
          '<div class="size-chart-popup__backdrop"></div>' +
          '<div class="size-chart-popup__content">' +
            '<button type="button" class="size-chart-popup__close" aria-label="Close size chart">&times;</button>' +
            '<img id="size-chart-popup-img-body" src="" alt="Size Chart" class="size-chart-popup__image" width="900" height="600">' +
          '</div>';
        document.body.appendChild(popup);
      }
      return popup;
    }

    document.addEventListener('click', function(e) {
      var trigger = e.target.closest('.size-chart-popup-trigger');
      if (!trigger) return;

      e.preventDefault();
      e.stopPropagation();

      var chartType = trigger.getAttribute('data-size-chart');
      var imageUrl = sizeChartImages[chartType];
      if (!imageUrl) return;

      var popup = getOrCreateBodyPopup();
      var img = popup.querySelector('.size-chart-popup__image');
      img.src = imageUrl;
      var altNames = { belt: 'Nylon Duty Belt', shirt: 'GFS All Polyester Long Sleeve Shirt', pants: 'H-BDU Trousers' };
      img.alt = (altNames[chartType] || chartType) + ' Size Chart';
      popup.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }, true);

    // Block mousedown, touchstart, AND click on the popup from reaching the
    // drawer/popover focus trap. The focus trap deactivates (closes the drawer)
    // on mousedown via checkPointerDown, not click — so we must intercept all three.
    function blockPopupEvent(e) {
      var popup = document.getElementById('size-chart-popup-body');
      if (!popup || popup.style.display === 'none') return;

      if (e.target.closest('#size-chart-popup-body')) {
        e.stopImmediatePropagation();

        if (e.target.closest('.size-chart-popup__close') || e.target.closest('.size-chart-popup__backdrop')) {
          e.preventDefault();
          popup.style.display = 'none';
          document.body.style.overflow = '';
        }
      }
    }
    document.addEventListener('mousedown', blockPopupEvent, true);
    document.addEventListener('touchstart', blockPopupEvent, true);
    document.addEventListener('click', blockPopupEvent, true);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        var popup = document.getElementById('size-chart-popup-body');
        if (popup && popup.style.display !== 'none') {
          e.preventDefault();
          e.stopImmediatePropagation();
          popup.style.display = 'none';
          document.body.style.overflow = '';
        }
      }
    }, true);
  })();
</script>

