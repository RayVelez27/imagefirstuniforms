    </div>
    {%- endif -%}

    {%- unless is_bls_manager or is_akima_manager -%}
    <div class="settings-section">
      <h3 class="settings-section-title">Email Notifications</h3>
      <p class="settings-section-description">Order confirmations and notifications will be sent to these addresses.</p>

      <div class="settings-grid">
        <div class="form-group">
          <label for="notify-primary">Primary Email</label>
          <input type="email" id="notify-primary" name="notifyPrimary">
        </div>
        <div class="form-group">
          <label for="notify-secondary">Secondary Email</label>
          <input type="email" id="notify-secondary" name="notifySecondary">
        </div>
      </div>

      <div class="section-actions">
        <button type="button" id="save-notifications-btn" class="button button--primary">Save Notifications</button>
        <span id="notifications-success" class="section-success" style="display: none;">Saved!</span>
        <span id="notifications-error" class="section-error" style="display: none;"></span>
      </div>
    </div>

    <div class="settings-section">
      <h3 class="settings-section-title">Global PO Number</h3>
      <p class="settings-section-description">This PO number will be applied to all company orders.</p>

      <div class="settings-grid">
        <div class="form-group">
          <label for="global-po">PO Number</label>
          <input type="text" id="global-po" name="globalPO">
        </div>
      </div>

      <div class="section-actions">
        <button type="button" id="save-po-btn" class="button button--primary">Save PO Number</button>
        <span id="po-success" class="section-success" style="display: none;">Saved!</span>
        <span id="po-error" class="section-error" style="display: none;"></span>
      </div>
    </div>
    {%- endunless -%}
  </form>
</div>

<style>
  .dashboard-settings {
    max-width: 800px;
  }

  .settings-form {
    margin-top: 20px;
  }

  .settings-section {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 25px;
    margin-bottom: 25px;
  }

  .settings-section-title {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 8px 0;
  }

  .settings-section-description {
    color: #666;
    font-size: 14px;
    margin: 0 0 20px 0;
  }

  .settings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
  }

  .settings-grid .form-group {
    margin-bottom: 0;
  }

  .settings-grid .form-group.full-width {
    grid-column: 1 / -1;
  }

  .settings-grid .form-group label {
    display: block;
    margin-bottom: 6px;
    font-weight: 500;
    font-size: 14px;
  }

  .settings-grid .form-group input,
  .settings-grid .form-group select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 14px;
    box-sizing: border-box;
    background-color: #fff;
  }

  .settings-grid .form-group input:focus,
  .settings-grid .form-group select:focus {
    outline: none;
    border-color: #4CAF50;
  }

  .section-actions {
    margin-top: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .section-success {
    color: #2e7d32;
    font-size: 14px;
    font-weight: 500;
  }

  .section-error {
    color: #d32f2f;
    font-size: 14px;
  }

  /* Locations section */
  .locations-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 10px;
  }

  .location-row {
    display: grid;
    grid-template-columns: 1fr 1.4fr auto;
    align-items: center;
    gap: 15px;
    padding: 12px 14px;
    border: 1px solid #eee;
    border-radius: 6px;
    background: #fafafa;
  }

  .location-name {
    font-weight: 600;
    font-size: 14px;
  }

  .location-address-input {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 14px;
    box-sizing: border-box;
    background-color: #fff;
  }

  .location-address-input:focus {
    outline: none;
    border-color: #4CAF50;
  }

  .card-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    white-space: nowrap;
  }

  .card-toggle input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .card-toggle__slider {
    position: relative;
    width: 44px;
    height: 24px;
    background: #ccc;
    border-radius: 24px;
    transition: background 0.2s ease;
    flex: none;
  }

  .card-toggle__slider::before {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    background: #fff;
    border-radius: 50%;
    transition: transform 0.2s ease;
  }

  .card-toggle input:checked + .card-toggle__slider {
    background: #4CAF50;
  }

  .card-toggle input:checked + .card-toggle__slider::before {
    transform: translateX(20px);
  }

  .card-toggle input:focus-visible + .card-toggle__slider {
    box-shadow: 0 0 0 2px rgba(76, 175, 80, 0.4);
  }

  .card-toggle__label {
    font-size: 13px;
    font-weight: 500;
    color: #333;
  }

  @media (max-width: 600px) {
    .settings-grid {
      grid-template-columns: 1fr;
    }

    .location-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const SETTINGS_API_BASE = 'https://image-first-portal.netlify.app/.netlify/functions';
  const companyId = {{ company_slug | json }};

  document.addEventListener('DOMContentLoaded', function() {
    const settingsTab = document.querySelector('[data-tab="tab-settings"]');
    let settingsLoaded = false;

    if (settingsTab) {
      settingsTab.addEventListener('click', function() {
        if (!settingsLoaded) {
          loadGlobalSettings();
          settingsLoaded = true;
        }
      });
    }

    // Attach save handlers for each section
    document.getElementById('save-billing-btn').addEventListener('click', handleSaveBilling);
    var notificationsBtn = document.getElementById('save-notifications-btn');
    if (notificationsBtn) notificationsBtn.addEventListener('click', handleSaveNotifications);
    var poBtn = document.getElementById('save-po-btn');
    if (poBtn) poBtn.addEventListener('click', handleSavePO);

    // Locations section (Extended + Manager + Target managers only)
    initTargetLocations();
  });

  async function loadGlobalSettings() {
    try {
      var url = `${SETTINGS_API_BASE}/get-global-settings`;
      if (companyId) url += '?company=' + encodeURIComponent(companyId);
      const response = await fetch(url);
      const data = await response.json();

      if (data.error) {
        console.log('No existing settings found');
        return;
      }

      if (data.settings) {
        populateForm(data.settings);
        applyLocationOverrides(data.settings.locationsJson);
      }
    } catch (error) {
      console.error('Error loading settings:', error);
    }
  }

  function populateForm(settings) {
    const fieldMap = {
      'billing-first-name': settings.billingFirstName,
      'billing-last-name': settings.billingLastName,
      'billing-company-name': settings.billingCompanyName,
      'billing-address': settings.billingAddress,
      'billing-address2': settings.billingAddress2,
      'billing-city': settings.billingCity,
      'billing-state': settings.billingState,
      'billing-zip': settings.billingZip,
      'billing-country': settings.billingCountry,
      'billing-email': settings.billingEmail,
      'billing-phone': settings.billingPhone,
      'notify-primary': settings.notifyPrimary,
      'notify-secondary': settings.notifySecondary,
      'global-po': settings.globalPO
    };

    for (const [fieldId, value] of Object.entries(fieldMap)) {
      const field = document.getElementById(fieldId);
      if (field && value) {
        field.value = value;
      }
    }
  }

  async function saveSection(sectionData, btnId, successId, errorId, btnText) {
    const btn = document.getElementById(btnId);
    const successEl = document.getElementById(successId);
    const errorEl = document.getElementById(errorId);

    try {
      btn.disabled = true;
      btn.textContent = 'Saving...';
      successEl.style.display = 'none';
      errorEl.style.display = 'none';

      if (companyId) sectionData.company = companyId;
      const response = await fetch(`${SETTINGS_API_BASE}/save-global-settings`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(sectionData)
      });

      const data = await response.json();

      if (!response.ok || data.error) {
        throw new Error(data.error || 'Failed to save');
      }

      successEl.textContent = 'Saved!';
      successEl.style.display = 'inline';

      // Hide success message after 3 seconds
      setTimeout(() => {
        successEl.style.display = 'none';
      }, 3000);

    } catch (error) {
      console.error('Error saving:', error);
      errorEl.textContent = error.message || 'Failed to save. Please try again.';
      errorEl.style.display = 'inline';
    } finally {
      btn.disabled = false;
      btn.textContent = btnText;
    }
  }

  function handleSaveBilling() {
    const companyNameField = document.getElementById('billing-company-name');
    const emailField = document.getElementById('billing-email');

    const data = {
      billingFirstName: document.getElementById('billing-first-name').value,
      billingLastName: document.getElementById('billing-last-name').value,
      billingCompanyName: companyNameField ? companyNameField.value : '',
      billingAddress: document.getElementById('billing-address').value,
      billingAddress2: document.getElementById('billing-address2').value,
      billingCity: document.getElementById('billing-city').value,
      billingState: document.getElementById('billing-state').value,
      billingZip: document.getElementById('billing-zip').value,
      billingCountry: document.getElementById('billing-country').value,
      billingEmail: emailField ? emailField.value : '',
      billingPhone: document.getElementById('billing-phone').value
    };
    saveSection(data, 'save-billing-btn', 'billing-success', 'billing-error', 'Save Billing Address');
  }

  function handleSaveNotifications() {
    const data = {
      notifyPrimary: document.getElementById('notify-primary').value,
      notifySecondary: document.getElementById('notify-secondary').value
    };
    saveSection(data, 'save-notifications-btn', 'notifications-success', 'notifications-error', 'Save Notifications');
  }

  function handleSavePO() {
    const data = {
      globalPO: document.getElementById('global-po').value
    };
    saveSection(data, 'save-po-btn', 'po-success', 'po-error', 'Save PO Number');
  }

  // ===== Target Locations =====
  // In-memory state: [{ name, shippingAddress, cardPayment }]. Seeded from the
  // defaults <script> block; overridden by saved settings (settings.locationsJson)
  // on load. Billing is universal (Global Billing Address); shipping is per-location.
  var locationsState = [];

  function initTargetLocations() {
    const list = document.getElementById('target-locations-list');
    if (!list) return; // section not rendered for this manager

    const defaultsEl = document.getElementById('target-locations-defaults');
    let defaults = [];
    try {
      defaults = JSON.parse(defaultsEl.textContent);
    } catch (e) {
      console.error('Could not parse location defaults:', e);
    }

    locationsState = defaults.map(function (d) {
      return { name: d.name, shippingAddress: d.address || '', cardPayment: true };
    });

    renderLocations();

    const saveBtn = document.getElementById('save-locations-btn');
    if (saveBtn) saveBtn.addEventListener('click', handleSaveLocations);
  }

  function renderLocations() {
    const list = document.getElementById('target-locations-list');
    if (!list) return;
    list.innerHTML = '';

    locationsState.forEach(function (loc, i) {
      const row = document.createElement('div');
      row.className = 'location-row';
      row.dataset.index = i;

      const nameEl = document.createElement('div');
      nameEl.className = 'location-name';
      nameEl.textContent = loc.name;

      const addrWrap = document.createElement('div');
      addrWrap.className = 'location-address';
      const addr = document.createElement('input');
      addr.type = 'text';
      addr.className = 'location-address-input';
      addr.value = loc.shippingAddress || '';
      addr.setAttribute('aria-label', 'Shipping address for ' + loc.name);
      addr.setAttribute('placeholder', 'Shipping address');
      addrWrap.appendChild(addr);

      const toggle = document.createElement('label');
      toggle.className = 'card-toggle';
      const cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.className = 'location-card-payment';
      cb.checked = !!loc.cardPayment;
      const slider = document.createElement('span');
      slider.className = 'card-toggle__slider';
      const tlabel = document.createElement('span');
      tlabel.className = 'card-toggle__label';
      tlabel.textContent = 'Card Payment';
      toggle.appendChild(cb);
      toggle.appendChild(slider);
      toggle.appendChild(tlabel);

      row.appendChild(nameEl);
      row.appendChild(addrWrap);
      row.appendChild(toggle);
      list.appendChild(row);
    });
  }

  function applyLocationOverrides(raw) {
    if (!raw || !locationsState.length) return;
    let overrides;
    try {
      overrides = typeof raw === 'string' ? JSON.parse(raw) : raw;
    } catch (e) {
      console.error('Could not parse saved locations:', e);
      return;
    }
    if (!overrides || typeof overrides !== 'object') return;

    locationsState.forEach(function (loc) {
      const o = overrides[loc.name];
      if (o && typeof o === 'object') {
        // Accept `shippingAddress` (current) or legacy `address` from earlier saves
        if (typeof o.shippingAddress === 'string') loc.shippingAddress = o.shippingAddress;
        else if (typeof o.address === 'string') loc.shippingAddress = o.address;
        if (typeof o.cardPayment === 'boolean') loc.cardPayment = o.cardPayment;
      }
    });

    renderLocations();
  }

  function handleSaveLocations() {
    const list = document.getElementById('target-locations-list');
    if (!list) return;

    const out = {};
    list.querySelectorAll('.location-row').forEach(function (row) {
      const i = parseInt(row.dataset.index, 10);
      if (isNaN(i) || !locationsState[i]) return;
      const name = locationsState[i].name;
      const shippingAddress = row.querySelector('.location-address-input').value;
      const cardPayment = row.querySelector('.location-card-payment').checked;

      // Keep state in sync so a later reload/re-render reflects edits
      locationsState[i].shippingAddress = shippingAddress;
      locationsState[i].cardPayment = cardPayment;

      out[name] = { shippingAddress: shippingAddress, cardPayment: cardPayment };
    });

    // Stored as a JSON string so it rides along with the existing scalar
    // global-settings fields without needing a backend schema change.
    const data = { locationsJson: JSON.stringify(out) };
    saveSection(data, 'save-locations-btn', 'locations-success', 'locations-error', 'Save Locations');
  }
</script>
