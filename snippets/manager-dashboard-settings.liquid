</style>

<script>
  const SETTINGS_API_BASE = 'https://image-first-portal.netlify.app/.netlify/functions';
  const companyId = {{ company_slug | json }};

  document.addEventListener('DOMContentLoaded', function() {
    const settingsTab = document.querySelector('[data-tab="tab-settings"]');
    let settingsLoaded = false;

    if (settingsTab) {
      settingsTab.addEventListener('click', function() {
        if (!settingsLoaded) {
          loadGlobalSettings();
          settingsLoaded = true;
        }
      });
    }

    // Attach save handlers for each section
    document.getElementById('save-billing-btn').addEventListener('click', handleSaveBilling);
    var notificationsBtn = document.getElementById('save-notifications-btn');
    if (notificationsBtn) notificationsBtn.addEventListener('click', handleSaveNotifications);
    var poBtn = document.getElementById('save-po-btn');
    if (poBtn) poBtn.addEventListener('click', handleSavePO);

    // Locations section (Extended + Manager + Target managers only)
    initTargetLocations();
  });

  async function loadGlobalSettings() {
    try {
      var url = `${SETTINGS_API_BASE}/get-global-settings`;
      if (companyId) url += '?company=' + encodeURIComponent(companyId);
      const response = await fetch(url);
      const data = await response.json();

      if (data.error) {
        console.log('No existing settings found');
        return;
      }

      if (data.settings) {
        populateForm(data.settings);
        applyLocationOverrides(data.settings.locationsJson);
      }
    } catch (error) {
      console.error('Error loading settings:', error);
    }
  }

  function populateForm(settings) {
    const fieldMap = {
      'billing-first-name': settings.billingFirstName,
      'billing-last-name': settings.billingLastName,
      'billing-company-name': settings.billingCompanyName,
      'billing-address': settings.billingAddress,
      'billing-address2': settings.billingAddress2,
      'billing-city': settings.billingCity,
      'billing-state': settings.billingState,
      'billing-zip': settings.billingZip,
      'billing-country': settings.billingCountry,
      'billing-email': settings.billingEmail,
      'billing-phone': settings.billingPhone,
      'notify-primary': settings.notifyPrimary,
      'notify-secondary': settings.notifySecondary,
      'global-po': settings.globalPO
    };

    for (const [fieldId, value] of Object.entries(fieldMap)) {
      const field = document.getElementById(fieldId);
      if (field && value) {
        field.value = value;
      }
    }
  }

  async function saveSection(sectionData, btnId, successId, errorId, btnText) {
    const btn = document.getElementById(btnId);
    const successEl = document.getElementById(successId);
    const errorEl = document.getElementById(errorId);

    try {
      btn.disabled = true;
      btn.textContent = 'Saving...';
      successEl.style.display = 'none';
      errorEl.style.display = 'none';

      if (companyId) sectionData.company = companyId;
      const response = await fetch(`${SETTINGS_API_BASE}/save-global-settings`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(sectionData)
      });

      const data = await response.json();

      if (!response.ok || data.error) {
        throw new Error(data.error || 'Failed to save');
      }

      successEl.textContent = 'Saved!';
      successEl.style.display = 'inline';

      // Hide success message after 3 seconds
      setTimeout(() => {
        successEl.style.display = 'none';
      }, 3000);

    } catch (error) {
      console.error('Error saving:', error);
      errorEl.textContent = error.message || 'Failed to save. Please try again.';
      errorEl.style.display = 'inline';
    } finally {
      btn.disabled = false;
      btn.textContent = btnText;
    }
  }

  function handleSaveBilling() {
    const companyNameField = document.getElementById('billing-company-name');
    const emailField = document.getElementById('billing-email');

    const data = {
      billingFirstName: document.getElementById('billing-first-name').value,
      billingLastName: document.getElementById('billing-last-name').value,
      billingCompanyName: companyNameField ? companyNameField.value : '',
      billingAddress: document.getElementById('billing-address').value,
      billingAddress2: document.getElementById('billing-address2').value,
      billingCity: document.getElementById('billing-city').value,
      billingState: document.getElementById('billing-state').value,
      billingZip: document.getElementById('billing-zip').value,
      billingCountry: document.getElementById('billing-country').value,
      billingEmail: emailField ? emailField.value : '',
      billingPhone: document.getElementById('billing-phone').value
    };
    saveSection(data, 'save-billing-btn', 'billing-success', 'billing-error', 'Save Billing Address');
  }

  function handleSaveNotifications() {
    const data = {
      notifyPrimary: document.getElementById('notify-primary').value,
      notifySecondary: document.getElementById('notify-secondary').value
    };
    saveSection(data, 'save-notifications-btn', 'notifications-success', 'notifications-error', 'Save Notifications');
  }

  function handleSavePO() {
    const data = {
      globalPO: document.getElementById('global-po').value
    };
    saveSection(data, 'save-po-btn', 'po-success', 'po-error', 'Save PO Number');
  }

  // ===== Target Locations =====
  // In-memory state: [{ name, address, city, state, zip, cardPayment }]. Seeded
  // from the defaults <script> block; overridden by saved settings
  // (settings.locationsJson) on load. Billing is universal (Global Billing
  // Address); shipping is per-location, split into full address fields.
  var locationsState = [];

  // Mirrors the Global Billing Address country dropdown.
  var LOCATION_COUNTRY_OPTIONS = [
    { value: '', label: 'Select Country' },
    { value: 'US', label: 'United States' },
    { value: 'CA', label: 'Canada' },
    { value: 'MX', label: 'Mexico' },
    { value: 'GB', label: 'United Kingdom' },
    { value: 'AU', label: 'Australia' },
    { value: 'DE', label: 'Germany' },
    { value: 'FR', label: 'France' },
    { value: 'IT', label: 'Italy' },
    { value: 'ES', label: 'Spain' },
    { value: 'NL', label: 'Netherlands' },
    { value: 'BE', label: 'Belgium' },
    { value: 'AT', label: 'Austria' },
    { value: 'CH', label: 'Switzerland' },
    { value: 'JP', label: 'Japan' },
    { value: 'CN', label: 'China' },
    { value: 'IN', label: 'India' },
    { value: 'BR', label: 'Brazil' },
    { value: 'AR', label: 'Argentina' }
  ];

  function initTargetLocations() {
    const list = document.getElementById('target-locations-list');
    if (!list) return; // section not rendered for this manager

    const defaultsEl = document.getElementById('target-locations-defaults');
    let defaults = [];
    try {
      defaults = JSON.parse(defaultsEl.textContent);
    } catch (e) {
      console.error('Could not parse location defaults:', e);
    }

    locationsState = defaults.map(function (d) {
      return {
        name: d.name,
        firstName: d.firstName || '',
        lastName: d.lastName || '',
        company: d.company || '',
        address: d.address || '',
        address2: d.address2 || '',
        city: d.city || '',
        state: d.state || '',
        zip: d.zip || '',
        country: d.country || '',
        phone: d.phone || '',
        cardPayment: true
      };
    });

    renderLocations();

    const searchInput = document.getElementById('locations-search-input');
    if (searchInput) searchInput.addEventListener('input', filterLocations);
  }

  function renderLocations() {
    const list = document.getElementById('target-locations-list');
    if (!list) return;
    list.innerHTML = '';

    locationsState.forEach(function (loc, i) {
      const row = document.createElement('div');
      row.className = 'location-row';
      row.dataset.index = i;

      const nameEl = document.createElement('div');
      nameEl.className = 'location-name';
      nameEl.textContent = loc.name;

      const addrWrap = document.createElement('div');
      addrWrap.className = 'location-address';
      const fieldsGrid = document.createElement('div');
      fieldsGrid.className = 'location-address-fields';

      function addField(labelText, cls, value, spanClass, type) {
        const group = document.createElement('div');
        group.className = 'location-field' + (spanClass ? ' ' + spanClass : '');
        const lab = document.createElement('label');
        lab.textContent = labelText;

        let field;
        if (type === 'select') {
          field = document.createElement('select');
          LOCATION_COUNTRY_OPTIONS.forEach(function (opt) {
            const o = document.createElement('option');
            o.value = opt.value;
            o.textContent = opt.label;
            if (opt.value === (value || '')) o.selected = true;
            field.appendChild(o);
          });
        } else {
          field = document.createElement('input');
          field.type = 'text';
          field.value = value || '';
        }
        field.className = cls;
        field.setAttribute('aria-label', labelText + ' for ' + loc.name);

        group.appendChild(lab);
        group.appendChild(field);
        fieldsGrid.appendChild(group);
        return field;
      }

      addField('First Name', 'location-first-input', loc.firstName, 'location-field--span3');
      addField('Last Name', 'location-last-input', loc.lastName, 'location-field--span3');
      addField('Company', 'location-company-input', loc.company, 'location-field--full');
      addField('Address', 'location-address-input', loc.address, 'location-field--full');
      addField('Address 2', 'location-address2-input', loc.address2, 'location-field--full');
      addField('City', 'location-city-input', loc.city, 'location-field--span2');
      addField('State/Province', 'location-state-input', loc.state, 'location-field--span2');
      addField('Zip/Postal Code', 'location-zip-input', loc.zip, 'location-field--span2');
      addField('Country', 'location-country-input', loc.country, 'location-field--span3', 'select');
      addField('Phone', 'location-phone-input', loc.phone, 'location-field--span3');

      addrWrap.appendChild(fieldsGrid);

      const toggle = document.createElement('label');
      toggle.className = 'card-toggle';
      const cb = document.createElement('input');
      cb.type = 'checkbox';
      cb.className = 'location-card-payment';
      cb.checked = !!loc.cardPayment;
      // Capture the toggle into state the moment it changes, so a re-render (e.g. the
      // async settings load) can't reset it back to the default before the row is saved.
      cb.addEventListener('change', function () {
        if (locationsState[i]) locationsState[i].cardPayment = cb.checked;
      });
      const slider = document.createElement('span');
      slider.className = 'card-toggle__slider';
      const tlabel = document.createElement('span');
      tlabel.className = 'card-toggle__label';
      tlabel.textContent = 'Card Payment';
      toggle.appendChild(cb);
      toggle.appendChild(slider);
      toggle.appendChild(tlabel);

      const actions = document.createElement('div');
      actions.className = 'location-row-actions';
      const saveBtn = document.createElement('button');
      saveBtn.type = 'button';
      saveBtn.className = 'button button--primary location-save-btn';
      saveBtn.textContent = 'Save';
      const status = document.createElement('span');
      status.className = 'location-status';
      status.style.display = 'none';
      saveBtn.addEventListener('click', function () {
        saveLocationRow(row, saveBtn, status);
      });
      actions.appendChild(saveBtn);
      actions.appendChild(status);

      // Top row: name on the left, Card Payment toggle + Save on the right
      const header = document.createElement('div');
      header.className = 'location-row-header';
      const controls = document.createElement('div');
      controls.className = 'location-row-controls';
      controls.appendChild(toggle);
      controls.appendChild(actions);
      header.appendChild(nameEl);
      header.appendChild(controls);

      // Bottom row: the address fields
      row.appendChild(header);
      row.appendChild(addrWrap);
      list.appendChild(row);
    });

    // Re-apply any active search filter after a full re-render
    filterLocations();
  }

  // Live substring search across each location's name and every field value.
  function filterLocations() {
    const input = document.getElementById('locations-search-input');
    const list = document.getElementById('target-locations-list');
    if (!list) return;
    const q = (input ? input.value : '').toLowerCase().trim();

    let visible = 0;
    list.querySelectorAll('.location-row').forEach(function (row) {
      let haystack = row.querySelector('.location-name').textContent.toLowerCase();
      row.querySelectorAll('input[type="text"], select').forEach(function (f) {
        haystack += ' ' + (f.value || '').toLowerCase();
      });
      const match = !q || haystack.indexOf(q) !== -1;
      row.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    const empty = document.getElementById('locations-empty');
    if (empty) empty.style.display = (visible === 0) ? 'block' : 'none';
  }

  function applyLocationOverrides(raw) {
    if (!raw || !locationsState.length) return;
    let overrides;
    try {
      overrides = typeof raw === 'string' ? JSON.parse(raw) : raw;
    } catch (e) {
      console.error('Could not parse saved locations:', e);
      return;
    }
    if (!overrides || typeof overrides !== 'object') return;

    locationsState.forEach(function (loc) {
      const o = overrides[loc.name];
      if (o && typeof o === 'object') {
        if (typeof o.firstName === 'string') loc.firstName = o.firstName;
        if (typeof o.lastName === 'string') loc.lastName = o.lastName;
        if (typeof o.company === 'string') loc.company = o.company;
        if (typeof o.address === 'string') loc.address = o.address;
        if (typeof o.address2 === 'string') loc.address2 = o.address2;
        if (typeof o.city === 'string') loc.city = o.city;
        if (typeof o.state === 'string') loc.state = o.state;
        if (typeof o.zip === 'string') loc.zip = o.zip;
        if (typeof o.country === 'string') loc.country = o.country;
        if (typeof o.phone === 'string') loc.phone = o.phone;
        // Legacy single-line saves (shippingAddress) fall back into the Address field
        if (o.address == null && typeof o.shippingAddress === 'string') loc.address = o.shippingAddress;
        if (typeof o.cardPayment === 'boolean') loc.cardPayment = o.cardPayment;
      }
    });

    renderLocations();
  }

  // Reads the current DOM values of every location row into `locationsState`.
  // All locations share one stored blob (locationsJson), so a per-row save must
  // still persist the full set to avoid clobbering the other rows' saved values.
  function syncLocationsFromDom() {
    const list = document.getElementById('target-locations-list');
    if (!list) return;
    list.querySelectorAll('.location-row').forEach(function (row) {
      const i = parseInt(row.dataset.index, 10);
      if (isNaN(i) || !locationsState[i]) return;
      locationsState[i].firstName = row.querySelector('.location-first-input').value;
      locationsState[i].lastName = row.querySelector('.location-last-input').value;
      locationsState[i].company = row.querySelector('.location-company-input').value;
      locationsState[i].address = row.querySelector('.location-address-input').value;
      locationsState[i].address2 = row.querySelector('.location-address2-input').value;
      locationsState[i].city = row.querySelector('.location-city-input').value;
      locationsState[i].state = row.querySelector('.location-state-input').value;
      locationsState[i].zip = row.querySelector('.location-zip-input').value;
      locationsState[i].country = row.querySelector('.location-country-input').value;
      locationsState[i].phone = row.querySelector('.location-phone-input').value;
      locationsState[i].cardPayment = row.querySelector('.location-card-payment').checked;
    });
  }

  function buildLocationsBlob() {
    const out = {};
    locationsState.forEach(function (loc) {
      out[loc.name] = {
        firstName: loc.firstName,
        lastName: loc.lastName,
        company: loc.company,
        address: loc.address,
        address2: loc.address2,
        city: loc.city,
        state: loc.state,
        zip: loc.zip,
        country: loc.country,
        phone: loc.phone,
        cardPayment: loc.cardPayment
      };
    });
    return out;
  }

  async function saveLocationRow(row, btn, statusEl) {
    // Capture every row's current values first so this save doesn't drop edits
    // made to other rows since the last save.
    syncLocationsFromDom();

    try {
      btn.disabled = true;
      btn.textContent = 'Saving...';
      statusEl.style.display = 'none';
      statusEl.classList.remove('location-status--success', 'location-status--error');

      // Stored as a JSON string so it rides along with the existing scalar
      // global-settings fields without needing a backend schema change.
      const payload = { locationsJson: JSON.stringify(buildLocationsBlob()) };
      if (companyId) payload.company = companyId;

      const response = await fetch(`${SETTINGS_API_BASE}/save-global-settings`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await response.json();

      if (!response.ok || data.error) {
        throw new Error(data.error || 'Failed to save');
      }

      statusEl.textContent = 'Saved!';
      statusEl.classList.add('location-status--success');
      statusEl.style.display = 'inline';
      setTimeout(function () {
        statusEl.style.display = 'none';
      }, 3000);

    } catch (error) {
      console.error('Error saving location:', error);
      statusEl.textContent = error.message || 'Failed to save.';
      statusEl.classList.add('location-status--error');
      statusEl.style.display = 'inline';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Save';
    }
  }
</script>
