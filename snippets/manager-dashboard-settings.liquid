  .card-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    white-space: nowrap;
  }

  .card-toggle input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .card-toggle__slider {
    position: relative;
    width: 44px;
    height: 24px;
    background: #ccc;
    border-radius: 24px;
    transition: background 0.2s ease;
    flex: none;
  }

  .card-toggle__slider::before {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    background: #fff;
    border-radius: 50%;
    transition: transform 0.2s ease;
  }

  .card-toggle input:checked + .card-toggle__slider {
    background: #4CAF50;
  }

  .card-toggle input:checked + .card-toggle__slider::before {
    transform: translateX(20px);
  }

  .card-toggle input:focus-visible + .card-toggle__slider {
    box-shadow: 0 0 0 2px rgba(76, 175, 80, 0.4);
  }

