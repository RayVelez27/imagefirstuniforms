    {%- unless is_bls_manager or is_akima_manager or is_target_manager -%}
    <div class="settings-section">
      <h3 class="settings-section-title">Email Notifications</h3>
      <p class="settings-section-description">Order confirmations and notifications will be sent to these addresses.</p>

      <div class="settings-grid">
        <div class="form-group">
          <label for="notify-primary">Primary Email</label>
          <input type="email" id="notify-primary" name="notifyPrimary">
        </div>
        <div class="form-group">
