{%- comment -%}
  Manager Dashboard - Settings Tab
  Extended manager settings for company-wide configurations
{%- endcomment -%}

{%- comment -%}Check if customer has Extended tag and Blue Life Security tag{%- endcomment -%}
{%- assign is_extended_customer = false -%}
{%- assign is_manager_customer = false -%}
{%- assign is_bls_manager = false -%}
{%- assign is_akima_manager = false -%}
{%- assign is_target_manager = false -%}
{%- assign company_slug = '' -%}
{%- if customer -%}
  {%- assign customer_tags_lower = customer.tags | join: ',' | downcase -%}
  {%- if customer_tags_lower contains 'extended' -%}
    {%- assign is_extended_customer = true -%}
  {%- endif -%}
  {%- if customer_tags_lower contains 'manager' -%}
    {%- assign is_manager_customer = true -%}
  {%- endif -%}
  {%- if customer_tags_lower contains 'blue life security' -%}
    {%- assign is_bls_manager = true -%}
    {%- assign company_slug = 'blue-life-security' -%}
  {%- elsif customer_tags_lower contains 'akima' -%}
    {%- assign is_akima_manager = true -%}
    {%- assign company_slug = 'akima' -%}
  {%- elsif customer_tags_lower contains 'gfs - uscis' -%}
    {%- assign company_slug = 'gfs-uscis' -%}
  {%- elsif customer_tags_lower contains 'target hospitality' -%}
    {%- assign is_target_manager = true -%}
    {%- assign company_slug = 'target-hospitality' -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Target locations edge case: only Extended + Manager + Target managers get the
  Locations section (per-location Card Payment toggle + editable mailing address).
{%- endcomment -%}
{%- assign show_target_locations = false -%}
{%- if is_extended_customer and is_manager_customer and is_target_manager -%}
  {%- assign show_target_locations = true -%}
{%- endif -%}

<div class="dashboard-settings" data-extended-customer="{{ is_extended_customer }}">
  <div class="dashboard-section-header">
    <h2 class="heading h3">
      {%- if company_slug == 'blue-life-security' -%}Blue Life Security - Company Settings
      {%- elsif company_slug == 'akima' -%}Akima - Company Settings
      {%- elsif company_slug == 'gfs-uscis' -%}GFS USCIS - Company Settings
      {%- elsif company_slug == 'target-hospitality' -%}Target Hospitality - Company Settings
      {%- else -%}Company Settings
      {%- endif -%}
    </h2>
    <p class="dashboard-description">Manage global settings for your company.</p>
  </div>

  <form id="company-settings-form" class="settings-form">

    <div class="settings-section">
      <h3 class="settings-section-title">Global Billing Address</h3>
      <p class="settings-section-description">This address will be used as the default billing address for all company orders.</p>

      <div class="settings-grid">
        <div class="form-group">
          <label for="billing-first-name">First Name</label>
          <input type="text" id="billing-first-name" name="billingFirstName">
        </div>
        <div class="form-group">
          <label for="billing-last-name">Last Name</label>
          <input type="text" id="billing-last-name" name="billingLastName">
        </div>
        {%- if is_extended_customer -%}
        <div class="form-group full-width">
          <label for="billing-company-name">Company Name</label>
          <input type="text" id="billing-company-name" name="billingCompanyName">
        </div>
        {%- endif -%}
        <div class="form-group full-width">
          <label for="billing-address">Address</label>
          <input type="text" id="billing-address" name="billingAddress">
        </div>
        <div class="form-group full-width">
          <label for="billing-address2">Address 2</label>
          <input type="text" id="billing-address2" name="billingAddress2">
        </div>
        <div class="form-group">
          <label for="billing-city">City</label>
          <input type="text" id="billing-city" name="billingCity">
        </div>
        <div class="form-group">
          <label for="billing-state">State/Province</label>
          <input type="text" id="billing-state" name="billingState">
        </div>
        <div class="form-group">
          <label for="billing-zip">Zip/Postal Code</label>
          <input type="text" id="billing-zip" name="billingZip">
        </div>
        <div class="form-group">
          <label for="billing-country">Country</label>
          <select id="billing-country" name="billingCountry">
            <option value="">Select Country</option>
            <option value="US">United States</option>
            <option value="CA">Canada</option>
            <option value="MX">Mexico</option>
            <option value="GB">United Kingdom</option>
            <option value="AU">Australia</option>
            <option value="DE">Germany</option>
            <option value="FR">France</option>
            <option value="IT">Italy</option>
            <option value="ES">Spain</option>
            <option value="NL">Netherlands</option>
            <option value="BE">Belgium</option>
            <option value="AT">Austria</option>
            <option value="CH">Switzerland</option>
            <option value="JP">Japan</option>
            <option value="CN">China</option>
            <option value="IN">India</option>
            <option value="BR">Brazil</option>
            <option value="AR">Argentina</option>
          </select>
        </div>
        {%- unless is_extended_customer -%}
        <div class="form-group">
          <label for="billing-email">Email</label>
          <input type="email" id="billing-email" name="billingEmail">
        </div>
        {%- endunless -%}
        <div class="form-group">
          <label for="billing-phone">Phone</label>
          <input type="tel" id="billing-phone" name="billingPhone">
        </div>
      </div>

      <div class="section-actions">
        <button type="button" id="save-billing-btn" class="button button--primary">Save Billing Address</button>
        <span id="billing-success" class="section-success" style="display: none;">Saved!</span>
        <span id="billing-error" class="section-error" style="display: none;"></span>
      </div>
    </div>

    {%- if show_target_locations -%}
    <div class="settings-section" id="locations-settings-section">
      <h3 class="settings-section-title">Locations</h3>
      <p class="settings-section-description">Billing uses the universal Global Billing Address above. Set each location&rsquo;s full shipping address and toggle Card Payment on or off, then save that location.</p>

      <div class="locations-search">
        <input type="text" id="locations-search-input" class="locations-search-input" placeholder="Search locations by name, city, state&hellip;" aria-label="Search locations" autocomplete="off">
      </div>

      <div id="target-locations-list" class="locations-list">
        <div class="dashboard-loading">Loading locations&hellip;</div>
      </div>

      <div id="locations-empty" class="dashboard-empty" style="display: none;">No locations match your search.</div>

