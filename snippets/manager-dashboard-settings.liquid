  .settings-grid .form-group {
    margin-bottom: 0;
  }

  .settings-grid .form-group.full-width {
    grid-column: 1 / -1;
  }

  .settings-grid .form-group label {
    display: block;
    margin-bottom: 6px;
    font-weight: 500;
    font-size: 14px;
  }

  .settings-grid .form-group input,
  .settings-grid .form-group select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 14px;
    box-sizing: border-box;
    background-color: #fff;
  }

  .settings-grid .form-group input:focus,
  .settings-grid .form-group select:focus {
    outline: none;
    border-color: #4CAF50;
  }

  .section-actions {
    margin-top: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .section-success {
    color: #2e7d32;
    font-size: 14px;
    font-weight: 500;
  }

  .section-error {
    color: #d32f2f;
