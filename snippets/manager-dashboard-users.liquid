{%- comment -%}
  Manager Dashboard - Users Tab
  Displays all users with the same company tag

  Parameters:
  - customer: The logged-in customer object
  - is_extended_manager: Boolean - if true, shows locations dropdown in Add User modal
{%- endcomment -%}

<div class="dashboard-users">
  <div class="dashboard-section-header">
    <h2 class="heading h3">{%- if is_extended_manager -%}All Users{%- else -%}Company Users{%- endif -%}</h2>
    <p class="dashboard-description">{%- if is_extended_manager -%}View and manage all users.{%- else -%}View all users in your company.{%- endif -%}</p>
    <button id="add-user-btn" class="button button--primary" style="margin-top: 15px;">
      Add New User
    </button>
  </div>

  {%- comment -%} Add User Modal {%- endcomment -%}
  <div id="add-user-modal" class="dashboard-modal" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Add New User</h3>
        <button id="close-modal" class="modal-close">&times;</button>
      </div>
      <form id="add-user-form">
        <div class="form-group">
          <label for="user-first-name">First Name *</label>
          <input type="text" id="user-first-name" name="firstName" required>
        </div>
        <div class="form-group">
          <label for="user-last-name">Last Name *</label>
          <input type="text" id="user-last-name" name="lastName" required>
        </div>
        <div class="form-group">
          <label for="user-email">Email *</label>
          <input type="email" id="user-email" name="email" required>
        </div>
        {%- if is_extended_manager -%}
          {%- assign _user_tags_lower = customer.tags | join: ',' | downcase -%}
          {%- if _user_tags_lower contains 'gfs - uscis' -%}
        <div class="form-group">
          <label for="user-location">Location *</label>
          <select id="user-location" name="location" required>
            <option value="">Select a location...</option>
            <option value="AL">Alabama (AL)</option>
            <option value="AZ">Arizona (AZ)</option>
            <option value="CA">California (CA)</option>
            <option value="CO">Colorado (CO)</option>
            <option value="CT">Connecticut (CT)</option>
            <option value="FL">Florida (FL)</option>
            <option value="GA">Georgia (GA)</option>
            <option value="IL">Illinois (IL)</option>
            <option value="IN">Indiana (IN)</option>
            <option value="MD">Maryland (MD)</option>
            <option value="MA">Massachusetts (MA)</option>
            <option value="MI">Michigan (MI)</option>
            <option value="MN">Minnesota (MN)</option>
            <option value="NJ">New Jersey (NJ)</option>
            <option value="NM">New Mexico (NM)</option>
            <option value="NY">New York (NY)</option>
            <option value="NC">North Carolina (NC)</option>
            <option value="OR">Oregon (OR)</option>
            <option value="SC">South Carolina (SC)</option>
            <option value="TN">Tennessee (TN)</option>
            <option value="TX">Texas (TX)</option>
            <option value="VA">Virginia (VA)</option>
          </select>
        </div>
          {%- elsif _user_tags_lower contains 'akima' -%}
        <div class="form-group">
          <label for="user-program">Program *</label>
          <select id="user-program" name="program" required>
            <option value="">Loading programs...</option>
          </select>
        </div>
          {%- endif -%}
        {%- endif -%}
        <div id="add-user-error" class="form-error" style="display: none;"></div>
        <div id="add-user-success" class="form-success" style="display: none;"></div>
        <div class="form-actions">
          <button type="button" id="cancel-add-user" class="button button--secondary">Cancel</button>
          <button type="submit" id="submit-add-user" class="button button--primary">Add User</button>
        </div>
      </form>
    </div>
  </div>

  {%- comment -%} Edit Tags Modal (Akima Extended Managers Only) {%- endcomment -%}
  {%- if is_extended_manager and is_akima_manager -%}
  <div id="edit-tags-modal" class="dashboard-modal" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Edit User Tags</h3>
        <button id="close-edit-tags-modal" class="modal-close">&times;</button>
      </div>
      <p id="edit-tags-user-name" style="margin-bottom: 15px; color: #666;"></p>
      <form id="edit-tags-form">
        <input type="hidden" id="edit-tags-user-id" value="">
        <div class="form-group">
          <label>Select program:</label>
          <div class="tags-checkbox-list" id="edit-tags-programs">
            <p style="color: #666;">Loading programs...</p>
          </div>
        </div>
        <div id="edit-tags-error" class="form-error" style="display: none;"></div>
        <div id="edit-tags-success" class="form-success" style="display: none;"></div>
        <div class="form-actions">
          <button type="button" id="cancel-edit-tags" class="button button--secondary">Cancel</button>
          <button type="submit" id="submit-edit-tags" class="button button--primary">Save Tags</button>
        </div>
      </form>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} Loading state {%- endcomment -%}
  <div id="users-loading" class="dashboard-loading">
    <p>Loading users...</p>
  </div>

  {%- comment -%} Error state {%- endcomment -%}
  <div id="users-error" class="dashboard-error" style="display: none;">
    <p><strong>Error:</strong> <span id="users-error-message"></span></p>
  </div>

  {%- comment -%} Users table container {%- endcomment -%}
  <div id="users-container" class="dashboard-table-wrapper" style="display: none;">
    <div class="users-summary" id="users-summary" style="margin-bottom: 20px; padding: 15px; background: #f8f8f8; border-radius: 4px;">
      {%- if is_extended_manager -%}
      <p style="margin: 0; font-weight: 500;">Total Users: <span id="total-users">0</span></p>
      {%- else -%}
      <p style="margin: 0; font-weight: 500;">Company: <span id="users-company-name">-</span> | Total Users: <span id="total-users">0</span></p>
      {%- endif -%}
    </div>

    {%- comment -%} Search and Filter Controls {%- endcomment -%}
    <div class="dashboard-filters">
      <div class="dashboard-filters__search">
        <input type="text" id="users-search" class="dashboard-filters__input" placeholder="Search by name or email...">
        <svg class="dashboard-filters__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <div class="dashboard-filters__dropdowns">
        <select id="users-filter-status" class="dashboard-filters__select">
          <option value="">All Statuses</option>
          <option value="enabled">Enabled</option>
          <option value="invited">Invited</option>
          <option value="disabled">Disabled</option>
        </select>
        <select id="users-filter-orders" class="dashboard-filters__select">
          <option value="">All Users</option>
          <option value="with-orders">With Orders</option>
          <option value="no-orders">No Orders</option>
        </select>
      </div>
      <div class="dashboard-filters__results">
        <span id="users-filter-count">Showing all users</span>
      </div>
    </div>

    <table class="dashboard-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Tags</th>
          <th>Total Orders</th>
          <th>Total Spent</th>
          <th>Account Created</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="users-table-body">
        {%- comment -%} Users will be populated via JavaScript {%- endcomment -%}
      </tbody>
    </table>
  </div>

  {%- comment -%} Empty state {%- endcomment -%}
  <div id="users-empty" class="dashboard-empty" style="display: none;">
    <p>No users found for your company.</p>
  </div>
</div>

<script>
  {%- comment -%}
    API endpoint for the Netlify serverless function
  {%- endcomment -%}
  const USERS_API_ENDPOINT = 'https://image-first-portal.netlify.app/.netlify/functions/manager-users';
  const AKIMA_PROGRAMS_ENDPOINT = 'https://image-first-portal.netlify.app/.netlify/functions/get-akima-programs';
  const IS_EXTENDED_MANAGER = {{ is_extended_manager | json }};
  const IS_AKIMA_MANAGER = {{ is_akima_manager | default: false | json }};

  let usersData = [];
  let filteredUsersData = [];
  let akimaPrograms = [];

  // Only load users when the Users tab is clicked
  document.addEventListener('DOMContentLoaded', function() {
    const usersTab = document.querySelector('[data-tab="tab-users"]');
    let usersLoaded = false;

    usersTab.addEventListener('click', function() {
      if (!usersLoaded) {
        loadUsers();
        usersLoaded = true;
      }
    });

    // Load Akima programs for the dropdown
    if (IS_AKIMA_MANAGER && IS_EXTENDED_MANAGER) {
      loadAkimaPrograms();
    }

    // Initialize modal functionality
    initializeAddUserModal();
    initializeUserFilters();
    initializeEditTagsModal();
  });

  async function loadAkimaPrograms() {
    try {
      const response = await fetch(AKIMA_PROGRAMS_ENDPOINT);
      const data = await response.json();

      if (data.programs && data.programs.length > 0) {
        akimaPrograms = data.programs;
        const select = document.getElementById('user-program');
        if (select) {
          select.innerHTML = '<option value="">Select a program...</option>';
          data.programs.forEach(program => {
            const option = document.createElement('option');
            option.value = program.tag;
            option.textContent = program.displayName;
            select.appendChild(option);
          });
        }
      } else {
        const select = document.getElementById('user-program');
        if (select) {
          select.innerHTML = '<option value="">No programs found</option>';
        }
      }
    } catch (error) {
      console.error('Error loading Akima programs:', error);
      const select = document.getElementById('user-program');
      if (select) {
        select.innerHTML = '<option value="">Error loading programs</option>';
      }
    }
  }

  function initializeUserFilters() {
    const searchInput = document.getElementById('users-search');
    const statusFilter = document.getElementById('users-filter-status');
    const ordersFilter = document.getElementById('users-filter-orders');

    searchInput.addEventListener('input', debounceUsers(applyUserFilters, 300));
    statusFilter.addEventListener('change', applyUserFilters);
    ordersFilter.addEventListener('change', applyUserFilters);
  }

  function debounceUsers(func, wait) {
    let timeout;
    return function executedFunction(...args) {
      const later = () => {
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

  function applyUserFilters() {
    const searchTerm = document.getElementById('users-search').value.toLowerCase().trim();
    const statusFilter = document.getElementById('users-filter-status').value;
    const ordersFilter = document.getElementById('users-filter-orders').value;

    filteredUsersData = usersData.filter(user => {
      // Search filter
      if (searchTerm) {
        const searchFields = [
          user.name || '',
          user.email || ''
        ].join(' ').toLowerCase();

        if (!searchFields.includes(searchTerm)) {
          return false;
        }
      }

      // Status filter
      if (statusFilter) {
        // Consider users with orders as "enabled" per previous logic
        const effectiveStatus = (user.state === 'enabled' || user.ordersCount > 0) ? 'enabled' : user.state;
        if (effectiveStatus !== statusFilter) {
          return false;
        }
      }

      // Orders filter
      const orderCount = parseInt(user.ordersCount, 10) || 0;
      if (ordersFilter === 'with-orders' && orderCount <= 0) {
        return false;
      }
      if (ordersFilter === 'no-orders' && orderCount > 0) {
        return false;
      }

      return true;
    });

    renderUsersTable(filteredUsersData);
    updateUserFilterCount();
  }

  function updateUserFilterCount() {
    const countEl = document.getElementById('users-filter-count');
    const total = usersData.length;
    const filtered = filteredUsersData.length;

    if (filtered === total) {
      countEl.textContent = `Showing all ${total} users`;
    } else {
      countEl.textContent = `Showing ${filtered} of ${total} users`;
    }
  }

  // Add User Modal Functionality
  function initializeAddUserModal() {
    const modal = document.getElementById('add-user-modal');
    const addUserBtn = document.getElementById('add-user-btn');
    const closeModal = document.getElementById('close-modal');
    const cancelBtn = document.getElementById('cancel-add-user');
    const form = document.getElementById('add-user-form');

    // Show modal
    addUserBtn.addEventListener('click', () => {
      modal.style.display = 'flex';
    });

    // Hide modal
    function hideModal() {
      modal.style.display = 'none';
      form.reset();
      document.getElementById('add-user-error').style.display = 'none';
      document.getElementById('add-user-success').style.display = 'none';
    }

    closeModal.addEventListener('click', hideModal);
    cancelBtn.addEventListener('click', hideModal);

    // Close modal when clicking outside
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        hideModal();
      }
    });

    // Handle form submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      await handleAddUser();
    });
  }

  // State code to full name mapping for GFS USCIS tags
  const stateNames = {
    'AL': 'Alabama',
    'AZ': 'Arizona',
    'CA': 'California',
    'CO': 'Colorado',
    'CT': 'Connecticut',
    'FL': 'Florida',
    'GA': 'Georgia',
    'IL': 'Illinois',
    'IN': 'Indiana',
    'MD': 'Maryland',
    'MA': 'Massachusetts',
    'MI': 'Michigan',
    'MN': 'Minnesota',
    'NJ': 'New Jersey',
    'NM': 'New Mexico',
    'NY': 'New York',
    'NC': 'North Carolina',
    'OR': 'Oregon',
    'SC': 'South Carolina',
    'TN': 'Tennessee',
    'TX': 'Texas',
    'VA': 'Virginia'
  };

  async function handleAddUser() {
    const submitBtn = document.getElementById('submit-add-user');
    const errorEl = document.getElementById('add-user-error');
    const successEl = document.getElementById('add-user-success');
    const customerId = {{ customer.id | json }};
    const locationField = document.getElementById('user-location');
    const isExtendedManager = {{ is_extended_manager | default: false | json }};
    {%- assign _is_gfs_manager = false -%}
    {%- assign _tags_check = customer.tags | join: ',' | downcase -%}
    {%- if _tags_check contains 'gfs - uscis' -%}{%- assign _is_gfs_manager = true -%}{%- endif -%}
    const isGfsUscisManager = {{ _is_gfs_manager | json }};
    const isAkimaManager = IS_AKIMA_MANAGER;
    const programField = document.getElementById('user-program');

    // Get form data
    const formData = {
      firstName: document.getElementById('user-first-name').value.trim(),
      lastName: document.getElementById('user-last-name').value.trim(),
      email: document.getElementById('user-email').value.trim(),
      managerId: customerId
    };

    // Add location and special tags if GFS - USCIS extended manager
    if (isExtendedManager && isGfsUscisManager && locationField && locationField.value) {
      formData.location = locationField.value;

      // GFS - USCIS managers: Add "Limit", "GFS USCIS [State]", and "GFS - USCIS" tags
      const stateCode = locationField.value;
      const stateName = stateNames[stateCode];
      if (stateName) {
        formData.tags = ['Limit', 'GFS USCIS ' + stateName, 'GFS - USCIS'];
      }
    }

    // Akima extended managers: Add "Limit", "Akima", and selected program tag
    if (isExtendedManager && isAkimaManager && programField && programField.value) {
      formData.tags = ['Limit', 'Akima', programField.value];
    }

    // Blue Life Security extended managers: Add "Limit" and "Blue Life Security" tags
    if (isExtendedManager && !isGfsUscisManager && !isAkimaManager) {
      formData.tags = ['Limit', 'Blue Life Security'];
    }

    // Basic validation
    if (!formData.firstName || !formData.lastName || !formData.email) {
      errorEl.textContent = 'Please fill in all required fields.';
      errorEl.style.display = 'block';
      return;
    }

    // Validate location for GFS - USCIS extended managers only
    if (isExtendedManager && isGfsUscisManager && !formData.location) {
      errorEl.textContent = 'Please select a location.';
      errorEl.style.display = 'block';
      return;
    }

    // Validate program for Akima extended managers
    if (isExtendedManager && isAkimaManager && (!programField || !programField.value)) {
      errorEl.textContent = 'Please select a program.';
      errorEl.style.display = 'block';
      return;
    }

    try {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Adding...';
      errorEl.style.display = 'none';
      successEl.style.display = 'none';

      // Call API to create user
      const response = await fetch('https://image-first-portal.netlify.app/.netlify/functions/add-user', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(formData)
      });

      const data = await response.json();

      if (!response.ok || data.error) {
        throw new Error(data.error || 'Failed to add user');
      }

      // Success - show message and reload users after a delay
      successEl.textContent = 'User added successfully! An activation email has been sent to ' + formData.email;
      successEl.style.display = 'block';
      document.getElementById('add-user-form').reset();

      // Reload users table after 2 seconds and close modal
      setTimeout(() => {
        document.getElementById('add-user-modal').style.display = 'none';
        successEl.style.display = 'none';
        loadUsers(); // Reload the users table
      }, 2000);

    } catch (error) {
      console.error('Error adding user:', error);
      errorEl.textContent = error.message || 'Failed to add user. Please try again.';
      errorEl.style.display = 'block';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Add User';
    }
  }

  function renderUsersTable(users) {
    const tableBody = document.getElementById('users-table-body');
    tableBody.innerHTML = '';

    if (users.length === 0) {
      tableBody.innerHTML = '<tr><td colspan="8" style="text-align: center; padding: 20px; color: #666;">No users match your filters</td></tr>';
      return;
    }

    users.forEach(user => {
      const row = document.createElement('tr');

      // Format tags (hide system/role tags)
      const hiddenTags = ['login with shop', 'shop', 'limit', 'extended'];
      const tags = (user.tags || []).filter(tag => !hiddenTags.includes(tag.toLowerCase().trim()));
      const tagsHtml = tags.map(tag =>
        `<span class="status-badge" style="margin-right: 5px; background: #e0e0e0; color: #333;">${escapeHtml(tag)}</span>`
      ).join('');

      row.innerHTML = `
        <td><strong>${escapeHtml(user.name || 'N/A')}</strong></td>
        <td>${escapeHtml(user.email || 'N/A')}</td>
        <td>${tagsHtml || 'No tags'}</td>
        <td>${user.ordersCount || 0}</td>
        <td>${user.currency || ''} ${formatMoney(user.totalSpent)}</td>
        <td>${formatDate(user.createdAt)}</td>
        <td><span class="status-badge ${getStatusBadgeClass(user)}">${getStatusLabel(user)}</span></td>
        <td class="actions-cell">
          ${(IS_AKIMA_MANAGER && IS_EXTENDED_MANAGER) ? `
          <button class="action-btn action-btn--edit-tags" data-user-id="${user.id}" data-user-name="${escapeHtml(user.name)}" title="Edit Tags">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
          </button>
          ` : ''}
          <button class="action-btn action-btn--resend" data-user-id="${user.id}" data-user-email="${escapeHtml(user.email)}" title="Resend Invite Email">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </button>
          <button class="action-btn action-btn--toggle ${user.isDisabled ? 'action-btn--enable' : 'action-btn--disable'}" data-user-id="${user.id}" data-user-name="${escapeHtml(user.name)}" data-user-disabled="${user.isDisabled}" title="${user.isDisabled ? 'Enable User' : 'Disable User'}">
            ${user.isDisabled ?
              `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <line x1="20" y1="8" x2="20" y2="14"></line>
                <line x1="17" y1="11" x2="23" y2="11"></line>
              </svg>` :
              `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <line x1="17" y1="11" x2="23" y2="11"></line>
              </svg>`
            }
          </button>
        </td>
      `;

      tableBody.appendChild(row);
    });

    // Add click handlers for action buttons
    addActionButtonHandlers();
  }

  async function loadUsers() {
    const customerId = {{ customer.id | json }};
    const loadingEl = document.getElementById('users-loading');
    const errorEl = document.getElementById('users-error');
    const containerEl = document.getElementById('users-container');
    const emptyEl = document.getElementById('users-empty');

    try {
      // Show loading state
      loadingEl.style.display = 'block';
      errorEl.style.display = 'none';
      containerEl.style.display = 'none';
      emptyEl.style.display = 'none';

      // Make API call - Extended managers get all Limit users
      const apiUrl = IS_EXTENDED_MANAGER
        ? `${USERS_API_ENDPOINT}?customerId=${customerId}&extended=true`
        : `${USERS_API_ENDPOINT}?customerId=${customerId}`;
      const response = await fetch(apiUrl);

      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }

      const data = await response.json();

      // Hide loading
      loadingEl.style.display = 'none';

      // Check for errors
      if (data.error) {
        errorEl.style.display = 'block';
        document.getElementById('users-error-message').textContent = data.error;
        return;
      }

      // Check if empty
      if (!data.users || data.users.length === 0) {
        emptyEl.style.display = 'block';
        return;
      }

      // Update summary
      const companyNameEl = document.getElementById('users-company-name');
      if (companyNameEl) {
        companyNameEl.textContent = data.companyTag || 'N/A';
      }
      document.getElementById('total-users').textContent = data.userCount || 0;

      usersData = data.users;
      filteredUsersData = data.users;

      renderUsersTable(filteredUsersData);
      updateUserFilterCount();

      // Show table
      containerEl.style.display = 'block';

    } catch (error) {
      console.error('Error loading users:', error);
      loadingEl.style.display = 'none';
      errorEl.style.display = 'block';
      document.getElementById('users-error-message').textContent =
        'Failed to load users. Please check that your API endpoint is configured correctly.';
    }
  }

  function formatDate(dateString) {
    if (!dateString) return 'N/A';
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
  }

  function formatMoney(amount) {
    if (!amount) return '0.00';
    return parseFloat(amount).toFixed(2);
  }

  function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function getStatusBadgeClass(user) {
    if (user.isDisabled) {
      return 'status-disabled';
    }
    const state = (user.state || '').toLowerCase();
    if (state === 'enabled' || user.ordersCount > 0) {
      return 'status-enabled';
    }
    if (state === 'invited') {
      return 'status-invited';
    }
    return 'status-invited'; // Default to invited for unknown states
  }

  function getStatusLabel(user) {
    if (user.isDisabled) {
      return 'Disabled';
    }
    const state = (user.state || '').toLowerCase();
    if (state === 'enabled' || user.ordersCount > 0) {
      return 'Enabled';
    }
    if (state === 'invited' || state === 'disabled') {
      // Capitalize first letter
      return state.charAt(0).toUpperCase() + state.slice(1);
    }
    // For any other state, format as Title Case
    if (user.state) {
      return user.state.charAt(0).toUpperCase() + user.state.slice(1).toLowerCase();
    }
    return 'Invited';
  }

  function addActionButtonHandlers() {
    // Resend invite handlers
    document.querySelectorAll('.action-btn--resend').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const userId = e.currentTarget.dataset.userId;
        const userEmail = e.currentTarget.dataset.userEmail;

        if (confirm(`Resend activation email to ${userEmail}?`)) {
          await handleResendInvite(userId, userEmail, e.currentTarget);
        }
      });
    });

    // Toggle user handlers (enable/disable)
    document.querySelectorAll('.action-btn--toggle').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const userId = e.currentTarget.dataset.userId;
        const userName = e.currentTarget.dataset.userName;
        const isDisabled = e.currentTarget.dataset.userDisabled === 'true';
        const action = isDisabled ? 'enable' : 'disable';

        if (confirm(`Are you sure you want to ${action} ${userName}?`)) {
          await handleToggleUser(userId, userName, action, e.currentTarget);
        }
      });
    });

    // Edit tags handlers (Akima Extended Managers)
    document.querySelectorAll('.action-btn--edit-tags').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const userId = e.currentTarget.dataset.userId;
        const userName = e.currentTarget.dataset.userName;
        const user = usersData.find(u => u.id == userId);
        const userTags = user ? (user.tags || []) : [];
        openEditTagsModal(userId, userName, userTags);
      });
    });
  }

  async function handleResendInvite(userId, userEmail, buttonEl) {
    const customerId = {{ customer.id | json }};
    const originalHtml = buttonEl.innerHTML;

    try {
      buttonEl.disabled = true;
      buttonEl.innerHTML = '<span class="loading-spinner"></span>';

      const response = await fetch('https://image-first-portal.netlify.app/.netlify/functions/resend-invite', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          userId: userId,
          managerId: customerId
        })
      });

      const data = await response.json();

      if (!response.ok || data.error) {
        throw new Error(data.error || 'Failed to resend invite');
      }

      // Show success feedback
      buttonEl.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>';
      setTimeout(() => {
        buttonEl.innerHTML = originalHtml;
        buttonEl.disabled = false;
      }, 2000);

      alert(`Activation email has been resent to ${userEmail}`);

    } catch (error) {
      console.error('Error resending invite:', error);
      buttonEl.innerHTML = originalHtml;
      buttonEl.disabled = false;
      alert(error.message || 'Failed to resend invite. Please try again.');
    }
  }

  async function handleToggleUser(userId, userName, action, buttonEl) {
    const customerId = {{ customer.id | json }};
    const originalHtml = buttonEl.innerHTML;

    try {
      buttonEl.disabled = true;
      buttonEl.innerHTML = '<span class="loading-spinner"></span>';

      const response = await fetch('https://image-first-portal.netlify.app/.netlify/functions/toggle-user', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          userId: userId,
          managerId: customerId,
          action: action
        })
      });

      const data = await response.json();

      if (!response.ok || data.error) {
        throw new Error(data.error || `Failed to ${action} user`);
      }

      // Update the button state
      const isNowDisabled = action === 'disable';
      buttonEl.dataset.userDisabled = isNowDisabled.toString();
      buttonEl.title = isNowDisabled ? 'Enable User' : 'Disable User';
      buttonEl.classList.toggle('action-btn--enable', isNowDisabled);
      buttonEl.classList.toggle('action-btn--disable', !isNowDisabled);

      // Update button icon
      if (isNowDisabled) {
        buttonEl.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="8.5" cy="7" r="4"></circle>
          <line x1="20" y1="8" x2="20" y2="14"></line>
          <line x1="17" y1="11" x2="23" y2="11"></line>
        </svg>`;
      } else {
        buttonEl.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="8.5" cy="7" r="4"></circle>
          <line x1="17" y1="11" x2="23" y2="11"></line>
        </svg>`;
      }

      // Update status badge in the row
      const row = buttonEl.closest('tr');
      const statusCell = row.querySelector('td:nth-child(7) .status-badge');
      if (statusCell) {
        statusCell.classList.remove('status-enabled', 'status-invited', 'status-disabled');
        if (isNowDisabled) {
          statusCell.textContent = 'Disabled';
          statusCell.classList.add('status-disabled');
        } else {
          statusCell.textContent = 'Enabled';
          statusCell.classList.add('status-enabled');
        }
      }

      // Update local data
      const userIndex = usersData.findIndex(u => u.id == userId);
      if (userIndex !== -1) {
        usersData[userIndex].isDisabled = isNowDisabled;
        usersData[userIndex].state = isNowDisabled ? 'disabled' : 'enabled';
      }
      const filteredIndex = filteredUsersData.findIndex(u => u.id == userId);
      if (filteredIndex !== -1) {
        filteredUsersData[filteredIndex].isDisabled = isNowDisabled;
        filteredUsersData[filteredIndex].state = isNowDisabled ? 'disabled' : 'enabled';
      }

      buttonEl.disabled = false;
      alert(`${userName} has been ${action}d successfully.`);

    } catch (error) {
      console.error(`Error ${action}ing user:`, error);
      buttonEl.innerHTML = originalHtml;
      buttonEl.disabled = false;
      alert(error.message || `Failed to ${action} user. Please try again.`);
    }
  }

  // === Edit Tags Modal (Akima Extended Managers) ===

  function initializeEditTagsModal() {
    const modal = document.getElementById('edit-tags-modal');
    if (!modal) return;

    const closeBtn = document.getElementById('close-edit-tags-modal');
    const cancelBtn = document.getElementById('cancel-edit-tags');
    const form = document.getElementById('edit-tags-form');

    function hideModal() {
      modal.style.display = 'none';
      document.getElementById('edit-tags-error').style.display = 'none';
      document.getElementById('edit-tags-success').style.display = 'none';
    }

    closeBtn.addEventListener('click', hideModal);
    cancelBtn.addEventListener('click', hideModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) hideModal();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      await handleSaveUserTags();
    });
  }

  function openEditTagsModal(userId, userName, currentTags) {
    const modal = document.getElementById('edit-tags-modal');
    document.getElementById('edit-tags-user-id').value = userId;
    document.getElementById('edit-tags-user-name').textContent = 'Editing tags for: ' + userName;

    // Build checkboxes from loaded Akima programs
    const container = document.getElementById('edit-tags-programs');
    if (akimaPrograms.length === 0) {
      container.innerHTML = '<p style="color: #999;">No programs available.</p>';
    } else {
      container.innerHTML = akimaPrograms.map(program => {
        const checked = currentTags.includes(program.tag) ? 'checked' : '';
        return `
          <label class="tag-checkbox">
            <input type="checkbox" name="tags" value="${escapeHtml(program.tag)}" ${checked}>
            <span>${escapeHtml(program.displayName)}</span>
          </label>
        `;
      }).join('');
    }

    document.getElementById('edit-tags-error').style.display = 'none';
    document.getElementById('edit-tags-success').style.display = 'none';
    modal.style.display = 'flex';
  }

  async function handleSaveUserTags() {
    const submitBtn = document.getElementById('submit-edit-tags');
    const errorEl = document.getElementById('edit-tags-error');
    const successEl = document.getElementById('edit-tags-success');
    const userId = document.getElementById('edit-tags-user-id').value;
    const modal = document.getElementById('edit-tags-modal');
    const customerId = {{ customer.id | json }};

    const selectedTags = [];
    modal.querySelectorAll('input[name="tags"]:checked').forEach(cb => {
      selectedTags.push(cb.value);
    });

    try {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Saving...';
      errorEl.style.display = 'none';
      successEl.style.display = 'none';

      const response = await fetch('https://image-first-portal.netlify.app/.netlify/functions/update-user-tags', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          userId: userId,
          tags: selectedTags,
          managerId: customerId
        })
      });

      const data = await response.json();

      if (!response.ok || data.error) {
        throw new Error(data.error || 'Failed to update tags');
      }

      successEl.textContent = 'Tags updated successfully!';
      successEl.style.display = 'block';

      // Update local data
      const userIndex = usersData.findIndex(u => u.id == userId);
      if (userIndex !== -1) {
        usersData[userIndex].tags = data.tags
          ? data.tags.split(',').map(t => t.trim()).filter(t => t)
          : selectedTags;
      }

      setTimeout(() => {
        modal.style.display = 'none';
        successEl.style.display = 'none';
        loadUsers();
      }, 1500);

    } catch (error) {
      console.error('Error updating tags:', error);
      errorEl.textContent = error.message || 'Failed to update tags. Please try again.';
      errorEl.style.display = 'block';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Save Tags';
    }
  }
</script>

