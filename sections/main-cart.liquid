<script>
document.addEventListener('DOMContentLoaded', function() {
  var payLaterBtn = document.getElementById('pay-later-btn');
  var payLaterModal = document.getElementById('pay-later-modal');
  var payLaterClose = document.getElementById('pay-later-close');
  var payLaterForm = document.getElementById('pay-later-form');
  var payLaterMessage = document.getElementById('pay-later-message');

  var calculateShippingBtn = document.getElementById('pay-later-calculate-shipping');
  var shippingRatesContainer = document.getElementById('pay-later-shipping-rates');
  var shippingOptionsContainer = document.getElementById('pay-later-shipping-options');
  var shippingMessage = document.getElementById('pay-later-shipping-message');
  var selectedShippingMethod = null;

  // Limited customer flag from Liquid
  var isLimitedCustomer = {{ is_limited_customer | json }};
  var isBulkOrderCustomer = {{ is_bulk_order_customer | json }};
  var isAkimaCompanyCustomer = {{ is_akima_company_customer | json }};
  var isManagerExtended = {{ is_manager_extended | json }};
  // Target Hospitality customer: billing comes from the TH global settings, shipping from the location.
  var isTargetCustomer = {{ has_target_tag | json }} === true;

  // Location pinned to the cart from the collection the customer ordered in (Target Hospitality).
  // Drives credit-card availability and Pay Later shipping for this cart.
  var pinnedLocationHandle = {{ cart.attributes['Location'] | json }};
  var pinnedLocation = null;

  // Global settings loaded from API (applies to all Limit users and Manager+Extended users)
  var globalSettings = null;

  // Customer company slug for per-company billing
  var customerCompany = {{ customer_company_slug | json }};

  // Delivery method toggle (Ship to Address vs Local Pickup) - only for non-limited customers
  var deliveryMethodShip = document.getElementById('delivery-method-ship');
  var deliveryMethodPickup = document.getElementById('delivery-method-pickup');
  var shippingAddressSection = document.getElementById('shipping-address-section');
  var shippingMethodSection = document.getElementById('shipping-method-section');
  var localPickupConfirmation = document.getElementById('local-pickup-confirmation');

  function setDeliveryMethod(method) {
    var sameAsShippingWrapper = document.querySelector('.pay-later-same-as-shipping');
    var billingEmailWrapper = document.getElementById('pay-later-billing-email-wrapper');
    var billingPhoneSpacer = document.getElementById('pay-later-billing-phone-spacer');

    if (method === 'pickup') {
      // Hide shipping address and shipping method sections
      if (shippingAddressSection) shippingAddressSection.style.display = 'none';
      if (shippingMethodSection) shippingMethodSection.style.display = 'none';
      if (localPickupConfirmation) localPickupConfirmation.style.display = 'block';

      // Hide "Same as shipping" checkbox, show billing email, hide spacer
      if (sameAsShippingWrapper) sameAsShippingWrapper.style.display = 'none';
      if (billingEmailWrapper) billingEmailWrapper.style.display = '';
      if (billingPhoneSpacer) billingPhoneSpacer.style.display = 'none';

      // Uncheck "same as shipping" if it was checked
      if (sameAsShippingCheckbox) {
        sameAsShippingCheckbox.checked = false;
        sameAsShippingCheckbox.dispatchEvent(new Event('change'));
      }

      // Remove required from hidden shipping address fields
      var shippingFields = shippingAddressSection ? shippingAddressSection.querySelectorAll('[required]') : [];
      shippingFields.forEach(function(f) { f.setAttribute('data-was-required', 'true'); f.removeAttribute('required'); });

      // Auto-set local pickup as the shipping method
      selectedShippingMethod = {
        name: 'Local Pickup - 400 Overpeck Avenue, Englewood NJ',
        price: 0,
        formatted_price: 'Free',
        code: 'LOCAL_PICKUP',
        source: 'local_pickup'
      };

      // Update toggle styling
      if (deliveryMethodShip) deliveryMethodShip.classList.remove('selected');
      if (deliveryMethodPickup) deliveryMethodPickup.classList.add('selected');
    } else {
      // Show shipping address and shipping method sections
      if (shippingAddressSection) shippingAddressSection.style.display = '';
      if (shippingMethodSection) shippingMethodSection.style.display = '';
      if (localPickupConfirmation) localPickupConfirmation.style.display = 'none';

      // Show "Same as shipping" checkbox, hide billing email, show spacer
      if (sameAsShippingWrapper) sameAsShippingWrapper.style.display = '';
      if (billingEmailWrapper) billingEmailWrapper.style.display = 'none';
      if (billingPhoneSpacer) billingPhoneSpacer.style.display = '';

      // Restore required on shipping address fields
      var shippingFields = shippingAddressSection ? shippingAddressSection.querySelectorAll('[data-was-required]') : [];
      shippingFields.forEach(function(f) { f.setAttribute('required', ''); f.removeAttribute('data-was-required'); });

      // Clear auto-set shipping method so user must calculate & choose
      selectedShippingMethod = null;

      // Update toggle styling
      if (deliveryMethodShip) deliveryMethodShip.classList.add('selected');
      if (deliveryMethodPickup) deliveryMethodPickup.classList.remove('selected');
    }
  }

  if (deliveryMethodShip) {
    deliveryMethodShip.addEventListener('click', function() { setDeliveryMethod('ship'); });
  }
  if (deliveryMethodPickup) {
    deliveryMethodPickup.addEventListener('click', function() { setDeliveryMethod('pickup'); });
  }

  // Function to load global settings for limited, Manager+Extended, and Target Hospitality customers
  async function loadGlobalSettings() {
    if (!isLimitedCustomer && !isManagerExtended && !isTargetCustomer) return;

    try {
      var url = 'https://image-first-portal.netlify.app/.netlify/functions/get-global-settings';
      if (customerCompany) url += '?company=' + encodeURIComponent(customerCompany);
      var response = await fetch(url);
      var data = await response.json();

      if (data.settings) {
        globalSettings = data.settings;
        // Pre-populate PO Number field
        var poField = document.getElementById('cart-po-number');
        if (poField && globalSettings.globalPO) {
          poField.value = globalSettings.globalPO;
          // Update cart attribute
          if (typeof window.updateCartAttribute === 'function') {
            window.updateCartAttribute('attributes[PO Number]', globalSettings.globalPO);
          }
        }
      }
    } catch (error) {
      console.error('Error loading global settings:', error);
    }
  }

  // Function to auto-populate billing address for limited and Manager+Extended customers
  function populateLimitedCustomerBillingAddress() {
    if ((!isLimitedCustomer && !isManagerExtended && !isTargetCustomer) || !globalSettings) return;

    var fields = {
      'pay-later-billing-first-name': globalSettings.billingFirstName,
      'pay-later-billing-last-name': globalSettings.billingLastName,
      'pay-later-billing-company': globalSettings.billingCompanyName,
      'pay-later-billing-address': globalSettings.billingAddress,
      'pay-later-billing-address2': globalSettings.billingAddress2,
      'pay-later-billing-city': globalSettings.billingCity,
      'pay-later-billing-province': globalSettings.billingState,
      'pay-later-billing-zip': globalSettings.billingZip,
      'pay-later-billing-country': globalSettings.billingCountry,
      'pay-later-billing-phone': globalSettings.billingPhone
    };

    for (var fieldId in fields) {
      var element = document.getElementById(fieldId);
      if (element && fields[fieldId]) {
        element.value = fields[fieldId];
      }
    }

    // Show Company Name field if it has a value (billing)
    var companyWrapper = document.getElementById('pay-later-billing-company-wrapper');
    if (companyWrapper && globalSettings.billingCompanyName) {
      companyWrapper.style.display = 'block';
    }

    // Auto-populate shipping company name for Limit customers
    var shippingCompanyField = document.getElementById('pay-later-company');
    var shippingCompanyWrapper = document.getElementById('pay-later-shipping-company-wrapper');
    if (shippingCompanyField && globalSettings.billingCompanyName) {
      shippingCompanyField.value = globalSettings.billingCompanyName;
      if (shippingCompanyWrapper) shippingCompanyWrapper.style.display = 'block';
    }

    // Also update the hidden country input for form submission (since select is disabled)
    var hiddenCountry = document.getElementById('pay-later-billing-country-hidden');
    if (hiddenCountry && globalSettings.billingCountry) {
      hiddenCountry.value = globalSettings.billingCountry;
    }
  }

  // ===== Pinned location (Target Hospitality collection) =====
  // Mirror Shopify's handle generation so a saved location name maps to its collection handle.
  function slugifyLocation(s) {
    return String(s == null ? '' : s).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  }

  // Resolve the pinned collection handle to a saved location, then apply card visibility.
  // Runs for any customer; a no-op when the cart has no pinned location.
  async function initPinnedLocation() {
    if (!pinnedLocationHandle) return;
    try {
      var resp = await fetch('https://image-first-portal.netlify.app/.netlify/functions/get-global-settings?company=target-hospitality');
      var data = await resp.json();
      if (!data || !data.settings || !data.settings.locationsJson) return;
      var locations;
      try {
        locations = typeof data.settings.locationsJson === 'string'
          ? JSON.parse(data.settings.locationsJson) : data.settings.locationsJson;
      } catch (e) {
        console.error('Pinned location: could not parse locationsJson', e);
        return;
      }
      if (!locations || typeof locations !== 'object') return;

      for (var key in locations) {
        if (Object.prototype.hasOwnProperty.call(locations, key) && slugifyLocation(key) === pinnedLocationHandle) {
          pinnedLocation = locations[key];
          break;
        }
      }
      if (!pinnedLocation) return;
      applyPinnedLocationCard();
    } catch (e) {
      console.error('Error loading pinned location:', e);
    }
  }

  // Card Payment toggle OFF for this location -> hide card / express / payment icons
  // so only Pay Later remains. Toggle ON (or unset-but-true) leaves the default UI.
  function applyPinnedLocationCard() {
    if (!pinnedLocation) return;
    if (pinnedLocation.cardPayment === true) {
      // Card allowed for this location -> reveal any card elements that were rendered
      // hidden for TH customers whose tags would otherwise suppress card payment.
      document.querySelectorAll('.th-card-gated').forEach(function (el) { el.style.display = ''; });
      return;
    }
    // Card not allowed for this location -> hide card / express / payment icons (Pay Later only).
    document.querySelectorAll('.cart__checkout-button').forEach(function (el) { el.style.display = 'none'; });
    document.querySelectorAll('.additional-checkout-buttons').forEach(function (el) {
      var block = el.closest('.cart__recap-block');
      (block || el).style.display = 'none';
    });
    var pm = document.querySelector('.cart__payment-methods');
    if (pm) pm.style.display = 'none';
  }

  // Prefill + lock (readonly) the Pay Later shipping address to the pinned location.
  function populatePinnedLocationShipping() {
    if (!pinnedLocation) return;
    var loc = pinnedLocation;
    var fields = {
      'pay-later-first-name': loc.firstName,
      'pay-later-last-name': loc.lastName,
      'pay-later-address': loc.address,
      'pay-later-address2': loc.address2,
      'pay-later-city': loc.city,
      'pay-later-province': loc.state,
      'pay-later-zip': loc.zip,
      'pay-later-phone': loc.phone
    };
    for (var id in fields) {
      if (!Object.prototype.hasOwnProperty.call(fields, id)) continue;
      var el = document.getElementById(id);
      if (!el) continue;
      el.value = fields[id] != null ? fields[id] : '';
      // readonly (not disabled) so the value is still included in FormData on submit.
      el.setAttribute('readonly', '');
      el.classList.add('pay-later-input--readonly');
    }

    // Country <select>: set value + lock by disabling the other options (keeps it in FormData).
    var countrySel = document.getElementById('pay-later-country');
    if (countrySel) {
      var cc = String(loc.country || '').toUpperCase();
      var full = cc === 'CA' ? 'Canada' : (cc === 'US' || cc === 'USA') ? 'United States' : '';
      if (full) {
        countrySel.value = full;
        for (var i = 0; i < countrySel.options.length; i++) {
          countrySel.options[i].disabled = (countrySel.options[i].value !== full);
        }
        countrySel.classList.add('pay-later-input--readonly');
      }
    }

    // Shipping company: fill + lock when the location has one.
    var companyField = document.getElementById('pay-later-company');
    if (companyField && loc.company) {
      companyField.value = loc.company;
      companyField.setAttribute('readonly', '');
      companyField.classList.add('pay-later-input--readonly');
      var companyWrapper = document.getElementById('pay-later-shipping-company-wrapper');
      if (companyWrapper) companyWrapper.style.display = 'block';
    }
  }

  // Load global settings on page load for limited, Manager+Extended, and Target Hospitality customers
  if (isLimitedCustomer || isManagerExtended || isTargetCustomer) {
    loadGlobalSettings();
  }

  // Resolve any pinned location collection and apply its card-payment rule
  initPinnedLocation();

  if (payLaterBtn) {
    payLaterBtn.addEventListener('click', function() {
      payLaterModal.classList.add('active');
      loadCartData();
      // Auto-populate shipping email for limited, Manager+Extended, and Target Hospitality customers
      if (isLimitedCustomer || isManagerExtended || isTargetCustomer) {
        var shippingEmailField = document.getElementById('pay-later-email');
        if (shippingEmailField) {
          shippingEmailField.value = {{ customer.email | json }};
        }
      }
      // Auto-populate billing address for limited and Manager+Extended customers
      populateLimitedCustomerBillingAddress();
      // Auto-populate + lock shipping to the pinned location collection (Target Hospitality)
      populatePinnedLocationShipping();
    });
  }

  if (payLaterClose) {
    payLaterClose.addEventListener('click', function() {
      payLaterModal.classList.remove('active');
      payLaterMessage.textContent = '';
    });
  }

  if (payLaterModal) {
    payLaterModal.addEventListener('click', function(e) {
      if (e.target === payLaterModal) {
        payLaterModal.classList.remove('active');
        payLaterMessage.textContent = '';
      }
    });
  }

  // "Same as shipping address" checkbox logic
  var sameAsShippingCheckbox = document.getElementById('pay-later-same-as-shipping');
  var billingFieldsContainer = document.getElementById('pay-later-billing-fields');
  if (sameAsShippingCheckbox) {
    var shippingToBillingMap = {
      'pay-later-first-name': 'pay-later-billing-first-name',
      'pay-later-last-name': 'pay-later-billing-last-name',
      'pay-later-company': 'pay-later-billing-company',
      'pay-later-address': 'pay-later-billing-address',
      'pay-later-address2': 'pay-later-billing-address2',
      'pay-later-city': 'pay-later-billing-city',
      'pay-later-province': 'pay-later-billing-province',
      'pay-later-zip': 'pay-later-billing-zip',
      'pay-later-country': 'pay-later-billing-country',
      'pay-later-phone': 'pay-later-billing-phone'
    };

    function copyShippingToBilling() {
      for (var shipId in shippingToBillingMap) {
        var shipEl = document.getElementById(shipId);
        var billEl = document.getElementById(shippingToBillingMap[shipId]);
        if (shipEl && billEl) {
          billEl.value = shipEl.value;
        }
      }
    }

    sameAsShippingCheckbox.addEventListener('change', function() {
      if (this.checked) {
        copyShippingToBilling();
        if (billingFieldsContainer) billingFieldsContainer.style.display = 'none';
      } else {
        if (billingFieldsContainer) billingFieldsContainer.style.display = '';
      }
    });
  }

  if (payLaterForm) {
    payLaterForm.addEventListener('submit', function(e) {
      e.preventDefault();

      if (!selectedShippingMethod) {
        showShippingMessage('Please select a shipping method before submitting.', 'error');
        return;
      }

      // If "same as shipping" is checked, copy values before building form data
      if (sameAsShippingCheckbox && sameAsShippingCheckbox.checked) {
        copyShippingToBilling();
      }

      payLaterMessage.textContent = 'Processing...';

      var formData = new FormData(payLaterForm);
      var shipping = {};
      var billing = {};
      formData.forEach(function(value, key) {
        if (key.startsWith('billing_')) {
          billing[key.replace('billing_', '')] = value;
        } else {
          shipping[key] = value;
        }
      });

      // For Local Pickup: shipping address fields are hidden/empty.
      // Use billing data so the draft order gets proper email, name, etc.
      var isLocalPickup = selectedShippingMethod && selectedShippingMethod.code === 'LOCAL_PICKUP';
      if (isLocalPickup) {
        shipping.email = billing.email || shipping.email;
        shipping.phone = billing.phone || shipping.phone;
        shipping.first_name = billing.first_name || shipping.first_name;
        shipping.last_name = billing.last_name || shipping.last_name;
        shipping.company = billing.company || shipping.company;
        // Use the pickup location as the shipping address
        shipping.address = '400 Overpeck Avenue';
        shipping.address2 = '';
        shipping.city = 'Englewood';
        shipping.province = 'NJ';
        shipping.zip = '07631';
        shipping.country = 'United States';
      }

      if (selectedShippingMethod) {
        shipping.selected_shipping_method = selectedShippingMethod;
      }

      fetch('/cart.js')
        .then(function(res) { return res.json(); })
        .then(function(cart) {
          var cartItemsWithProperties = [];
          if (cart.items && cart.items.length > 0) {
            cartItemsWithProperties = cart.items.map(function(item) {
              return {
                id: item.id,
                variant_id: item.variant_id,
                product_id: item.product_id,
                quantity: item.quantity,
                title: item.title,
                price: item.price,
                final_price: item.final_price,
                final_line_price: item.final_line_price,
                properties: item.properties || {}
              };
            });
          }

          // Extract special instructions before clearing cart.note
          var specialInstructions = cart.note || '';

          // Clear cart.note to prevent duplicate in Shopify's default Notes field
          // Special instructions are sent separately in special_instructions field
          delete cart.note;

          // Get PO number from input field first (more reliable), fallback to cart attributes
          var isAkimaCustomer = {{ has_akima_tag | json }};
          var poNumber = '';
          var projectNumber = '';
          var glAccount = '';

          if (isAkimaCustomer) {
            var projectField = document.getElementById('cart-project-number');
            var glField = document.getElementById('cart-gl-account');
            projectNumber = projectField ? projectField.value : '';
            glAccount = glField ? glField.value : '';
          } else {
            var poNumberField = document.getElementById('cart-po-number');
            poNumber = (poNumberField && poNumberField.value)
              ? poNumberField.value
              : (cart.attributes && cart.attributes['PO Number'] ? cart.attributes['PO Number'] : '');
          }

          var payload = {
            cart: cart,
            cart_items_with_properties: cartItemsWithProperties,
            po_number: poNumber,
            project_number: projectNumber,
            gl_account: glAccount,
            special_instructions: specialInstructions,
            shipping: shipping,
            billing: billing,
            selected_shipping_method: selectedShippingMethod,
            customer_id: {{ customer.id | default: 'null' }}
          };

          return fetch('https://image-first-portal.netlify.app/.netlify/functions/create-draft-order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.success) {
            payLaterMessage.textContent = 'Pay Later Order Created Successfully!';
            payLaterMessage.style.color = '#155724';
            payLaterForm.reset();

            // Clear cart attributes (Special Instructions and PO Number) first
            var clearAttributesData = new FormData();
            clearAttributesData.append('note', '');
            clearAttributesData.append('attributes[PO Number]', '');
            clearAttributesData.append('attributes[Project Number]', '');
            clearAttributesData.append('attributes[G/L Account]', '');

            fetch('/cart/update.js', {
              method: 'POST',
              body: clearAttributesData
            })
              .then(function(response) {
                if (!response.ok) {
                  throw new Error('Failed to clear cart attributes');
                }
                return response.json();
              })
              .then(function() {
                // Now clear the cart items
                return fetch('/cart/clear.js', { method: 'POST' });
              })
              .then(function(response) {
                if (!response.ok) {
                  throw new Error('Failed to clear cart');
                }
                return response.json();
              })
              .then(function() {
                // Clear the visible form fields
                document.getElementById('cart-special-instructions').value = '';
                var poField = document.getElementById('cart-po-number');
                if (poField) poField.value = '';
                var projectNumField = document.getElementById('cart-project-number');
                var glAcctField = document.getElementById('cart-gl-account');
                if (projectNumField) projectNumField.value = '';
                if (glAcctField) glAcctField.value = '';

                // Clear bulk order sessionStorage so names don't linger
                sessionStorage.removeItem('bulkOrderCurrentPerson');
                sessionStorage.removeItem('bulkOrderPersonNames');

                // Wait for cart clear to complete, then redirect with page reload
                setTimeout(function() {
                  window.location.replace('/pages/thank-you');
                }, 1800);
              })
              .catch(function(error) {
                console.error('Cart clear error:', error);
                // Clear bulk order sessionStorage even if cart clear fails
                sessionStorage.removeItem('bulkOrderCurrentPerson');
                sessionStorage.removeItem('bulkOrderPersonNames');
                // Still redirect even if cart clear fails
                setTimeout(function() {
                  window.location.replace('/pages/thank-you');
                }, 1800);
              });
          } else {
            payLaterMessage.textContent = data.message || 'There was an error submitting your order.';
            payLaterMessage.style.color = '#721c24';
          }
        })
        .catch(function(err) {
          payLaterMessage.textContent = 'There was an error submitting your order.';
          payLaterMessage.style.color = '#721c24';
        });
    });
  }

  if (calculateShippingBtn) {
    calculateShippingBtn.addEventListener('click', function() {
      calculateShippingRates();
    });
  }

  function loadCartData() {
    fetch('/cart.js')
      .then(function(response) { return response.json(); })
      .then(function(cart) {
        window.cart = cart;
        console.log('Cart loaded:', cart);
      })
      .catch(function(error) {
        console.error('Error loading cart:', error);
      });
  }

  function calculateShippingRates() {
    var shippingAddress = {
      country: document.getElementById('pay-later-country').value || '',
      province: document.getElementById('pay-later-province').value || '',
      zip: document.getElementById('pay-later-zip').value || '',
      city: document.getElementById('pay-later-city').value || '',
      address1: document.getElementById('pay-later-address').value || ''
    };

    // Strip ZIP+4 to just 5 digits for carrier rate lookups
    if (shippingAddress.zip && shippingAddress.zip.indexOf('-') !== -1) {
      shippingAddress.zip = shippingAddress.zip.split('-')[0];
    }

    if (!shippingAddress.country || !shippingAddress.zip) {
      showShippingMessage('Please fill in at least Country and Zip Code before calculating rates.', 'error');
      return;
    }

    if (!window.cart || !window.cart.items || window.cart.items.length === 0) {
      showShippingMessage('Please add items to your cart before calculating shipping rates.', 'error');
      return;
    }

    calculateShippingBtn.disabled = true;
    calculateShippingBtn.textContent = 'Calculating...';
    showShippingMessage('', '');

    // Build query string with proper shipping address format
    var queryParams = [];
    queryParams.push('shipping_address[zip]=' + encodeURIComponent(shippingAddress.zip));
    queryParams.push('shipping_address[country]=' + encodeURIComponent(shippingAddress.country));

    if (shippingAddress.province) {
      queryParams.push('shipping_address[province]=' + encodeURIComponent(shippingAddress.province));
    }
    if (shippingAddress.city) {
      queryParams.push('shipping_address[city]=' + encodeURIComponent(shippingAddress.city));
    }
    if (shippingAddress.address1) {
      queryParams.push('shipping_address[address1]=' + encodeURIComponent(shippingAddress.address1));
    }

    var queryString = queryParams.join('&');

    console.log('Requesting shipping rates with:', queryString);

    fetch('/cart/shipping_rates.json?' + queryString)
      .then(function(response) {
        console.log('Shipping rates response status:', response.status);
        if (!response.ok) {
          throw new Error('HTTP error! status: ' + response.status);
        }
        return response.json();
      })
      .then(function(data) {
        console.log('Shipping rates full response:', JSON.stringify(data, null, 2));
        calculateShippingBtn.disabled = false;
        calculateShippingBtn.textContent = 'Calculate Shipping Rates';

        // Check different possible response structures
        var rates = data.shipping_rates || data.rates || [];

        console.log('Extracted rates:', rates);
        console.log('Rates length:', rates.length);

        if (rates && rates.length > 0) {
          displayShippingRates(rates);
          // Show "1 shipping option" for non-BLS/non-Akima Limit customers, actual count for others
          var shippingMessage = (isLimitedCustomer && !isBulkOrderCustomer && !isAkimaCompanyCustomer)
            ? 'Found 1 shipping option available.'
            : 'Found ' + rates.length + ' shipping option(s) available.';
          showShippingMessage(shippingMessage, 'success');
        } else {
          // Log the entire data object to see what we're getting
          console.warn('No shipping rates found. Full data object:', data);

          var errorMsg = 'No shipping rates available for this address.';
          if (data.message) {
            errorMsg = data.message;
          } else if (data.error) {
            errorMsg = data.error;
          }
          showShippingMessage(errorMsg + ' Please verify all address fields are correct.', 'error');
          shippingRatesContainer.style.display = 'none';
        }
      })
      .catch(function(error) {
        console.error('Shipping rates error:', error);
        calculateShippingBtn.disabled = false;
        calculateShippingBtn.textContent = 'Calculate Shipping Rates';
        showShippingMessage('Error calculating shipping rates. The cart may not have items requiring shipping, or the address may be invalid.', 'error');
      });
  }

  function displayShippingRates(rates) {
    shippingOptionsContainer.innerHTML = '';

    // Filter rates for Limit customers - only show UPS Ground (except BLS bulk order and Akima company customers who see all options)
    if (isLimitedCustomer && !isBulkOrderCustomer && !isAkimaCompanyCustomer) {
      rates = rates.filter(function(rate) {
        var rateName = (rate.name || rate.presentment_name || '').toLowerCase();
        return rateName.includes('ups') && rateName.includes('ground');
      });

      // If no UPS Ground found, show message
      if (rates.length === 0) {
        showShippingMessage('UPS Ground shipping is required for your account. Please contact support if this option is not available.', 'error');
        shippingRatesContainer.style.display = 'none';
        return;
      }
    }

    rates.forEach(function(rate, index) {
      var optionDiv = document.createElement('div');
      optionDiv.className = 'shipping-option';

      var radioInput = document.createElement('input');
      radioInput.type = 'radio';
      radioInput.name = 'shipping_method';
      radioInput.value = rate.name + ':' + rate.price;
      radioInput.id = 'shipping_' + index;

      var layoutDiv = document.createElement('div');
      layoutDiv.style.cssText = 'display:flex;justify-content:space-between;align-items:center;width:100%;';

      var nameDiv = document.createElement('div');
      nameDiv.className = 'shipping-option-name';
      nameDiv.textContent = rate.name || rate.presentment_name;

      var rightDiv = document.createElement('div');
      rightDiv.style.cssText = 'display:flex;flex-direction:column;align-items:flex-end;gap:0.2em;';

      var priceDiv = document.createElement('div');
      priceDiv.className = 'shipping-option-price';

      // Handle price - it's already in dollars as a string from UPS
      var priceInDollars = parseFloat(rate.price);
      priceDiv.textContent = '$' + priceInDollars.toFixed(2);

      var deliveryDiv = document.createElement('div');
      deliveryDiv.className = 'shipping-option-delivery';

      // Use delivery_date if available, otherwise use estimate
      if (rate.delivery_date) {
        var deliveryDate = new Date(rate.delivery_date);
        deliveryDiv.textContent = 'Delivery: ' + deliveryDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      } else if (rate.delivery_days && rate.delivery_days.length > 0) {
        var days = rate.delivery_days[0];
        deliveryDiv.textContent = days + ' business day' + (days > 1 ? 's' : '');
      } else {
        deliveryDiv.textContent = getDeliveryEstimate(rate.name);
      }

      rightDiv.appendChild(priceDiv);
      rightDiv.appendChild(deliveryDiv);
      layoutDiv.appendChild(nameDiv);
      layoutDiv.appendChild(rightDiv);
      optionDiv.appendChild(radioInput);
      optionDiv.appendChild(layoutDiv);

      optionDiv.addEventListener('click', function() {
        selectShippingOption(this, rate);
      });

      shippingOptionsContainer.appendChild(optionDiv);
    });

    if (rates.length > 0) {
      var firstOption = shippingOptionsContainer.querySelector('.shipping-option');
      if (firstOption) {
        selectShippingOption(firstOption, rates[0]);
      }
    }

    shippingRatesContainer.style.display = 'block';
  }

  function selectShippingOption(optionElement, rate) {
    // Deselect all shipping options
    var allOptions = shippingOptionsContainer.querySelectorAll('.shipping-option');
    allOptions.forEach(function(opt) {
      opt.classList.remove('selected');
    });

    optionElement.classList.add('selected');

    // Price is already in dollars as a string from UPS
    var priceInDollars = parseFloat(rate.price);

    selectedShippingMethod = {
      name: rate.name || rate.presentment_name,
      price: priceInDollars,
      formatted_price: '$' + priceInDollars.toFixed(2),
      code: rate.code,
      source: rate.source,
      delivery_date: rate.delivery_date,
      carrier_service_id: rate.carrier_service_id
    };

    console.log('Selected shipping method:', selectedShippingMethod);

    var radio = optionElement.querySelector('input[type="radio"]');
    if (radio) {
      radio.checked = true;
    }
  }

  function showShippingMessage(message, type) {
    shippingMessage.textContent = message;
    shippingMessage.className = 'shipping-message ' + (type || '');
  }

  function getDeliveryEstimate(shippingName) {
    var estimates = {
      'Ground': '3-7 business days',
      '2nd Day Air': '2 business days',
      'Next Day Air': '1 business day',
      'Next Day Air Saver': '1 business day',
      '3 Day Select': '3 business days',
      'Standard': '3-5 business days',
      'Express': '1-2 business days'
    };

    for (var key in estimates) {
      if (shippingName.includes(key)) {
        return estimates[key];
      }
    }

    return 'Delivery time varies';
  }
});
</script>

{% schema %}
{
  "name": "Cart",
  "blocks": [
    {
      "type": "totals",
      "name": "Totals",
      "limit": 1
    },
    {
      "type": "order_note",
      "name": "Order note",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "express_checkout_buttons",
      "name": "Express checkout buttons",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Make payment faster with accelerated payment buttons. [Learn more](https://shopify.dev/themes/pricing-payments/accelerated-checkout)"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment_methods",
      "label": "Show payment methods",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping_estimator",
      "label": "Show shipping rates calculator",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_estimator_default_country",
      "label": "Default country",
      "info": "If the customer is logged in, the country of their shipping address will be used.",
      "default": "United States",
      "visible_if": "{{ section.settings.show_shipping_estimator }}"
    },
    {
      "type": "text",
      "id": "empty_button_link",
      "label": "Empty button link",
      "default": "/pages/admin"
    }
  ]
}
{% endschema %}