            <style>
              .cart-attributes {
                margin-bottom: 2rem;
                padding: 1.5rem;
                background-color: rgb(var(--background));
                border: 1px solid rgb(var(--border-color));
                border-radius: var(--border-radius);
              }

              .cart-attributes__fields {
                display: flex;
                flex-direction: column;
                gap: 1.25rem;
              }

              .cart-attributes__field {
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
              }

              .cart-attributes__label {
                font-weight: 600;
                font-size: 0.875rem;
                color: rgb(var(--text-color));
                text-transform: uppercase;
                letter-spacing: 0.05em;
              }

              .cart-attributes__input,
              .cart-attributes__textarea {
                width: 100%;
                padding: 0.75rem;
                border: 1px solid rgb(var(--border-color));
                border-radius: var(--border-radius);
                background-color: rgb(var(--background));
                color: rgb(var(--text-color));
                font-size: 0.9375rem;
                font-family: inherit;
                transition: border-color 0.2s;
              }

              .cart-attributes__input:focus,
              .cart-attributes__textarea:focus {
                outline: none;
                border-color: rgb(var(--text-color));
                box-shadow: 0 0 0 1px rgb(var(--text-color));
              }

              .cart-attributes__textarea {
                resize: vertical;
                min-height: 80px;
              }

              .cart-attributes__input--readonly {
                background-color: #f5f5f5;
                color: #666;
                cursor: not-allowed;
                border-color: #ddd;
              }

              .cart-attributes__input--readonly:focus {
                outline: none;
                box-shadow: none;
                border-color: #ddd;
              }

              .cart-attributes__readonly-badge {
                font-weight: 400;
                font-size: 0.75rem;
                color: #888;
                text-transform: none;
                letter-spacing: normal;
              }

              /* Ordered For column (bulk order customers) */
              .line-item__ordered-for {
                vertical-align: middle;
              }

              .line-item__ordered-for-name {
                font-weight: 600;
                font-size: 0.9375rem;
                color: rgb(var(--text-color));
              }

              .line-item__ordered-for-mobile {
                display: flex;
                gap: 0.35rem;
                align-items: center;
                margin-top: 0.35rem;
              }

              .text--strong {
                font-weight: 600;
              }

              @media (max-width: 768px) {
                .cart-attributes {
                  padding: 1rem;
                  margin-bottom: 1.5rem;
                }

                .cart-attributes__fields {
                  gap: 1rem;
                }
              }
            </style>

            <script>
              (function() {
                if (typeof window.CartAttributesInitialized !== 'undefined') return;
                window.CartAttributesInitialized = true;

                document.addEventListener('DOMContentLoaded', function() {
                  const specialInstructionsField = document.getElementById('cart-special-instructions');
                  const poNumberField = document.getElementById('cart-po-number');

                  if (specialInstructionsField) {
                    let specialInstructionsTimeout;
                    specialInstructionsField.addEventListener('input', function() {
                      clearTimeout(specialInstructionsTimeout);
                      specialInstructionsTimeout = setTimeout(function() {
                        updateCartAttribute('note', specialInstructionsField.value);
                      }, 1000);
                    });
                  }

                  if (poNumberField) {
                    let poNumberTimeout;
                    poNumberField.addEventListener('input', function() {
                      clearTimeout(poNumberTimeout);
                      poNumberTimeout = setTimeout(function() {
                        updateCartAttribute('attributes[PO Number]', poNumberField.value);
                      }, 1000);
                    });
                  }

                  const projectNumberField = document.getElementById('cart-project-number');
                  const glAccountField = document.getElementById('cart-gl-account');

                  if (projectNumberField) {
                    let projectNumberTimeout;
                    projectNumberField.addEventListener('input', function() {
                      clearTimeout(projectNumberTimeout);
                      projectNumberTimeout = setTimeout(function() {
                        updateCartAttribute('attributes[Project Number]', projectNumberField.value);
                      }, 1000);
                    });
                  }

                  if (glAccountField) {
                    let glAccountTimeout;
                    glAccountField.addEventListener('input', function() {
                      clearTimeout(glAccountTimeout);
                      glAccountTimeout = setTimeout(function() {
                        updateCartAttribute('attributes[G/L Account]', glAccountField.value);
                      }, 1000);
                    });
                  }

                  window.updateCartAttribute = function(name, value) {
                    const formData = new FormData();
                    formData.append(name, value);

                    fetch('/cart/update.js', {
                      method: 'POST',
                      body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                      console.log('Cart attribute updated:', name, value);
                    })
                    .catch(error => {
                      console.error('Error updating cart attribute:', error);
                    });
                  };
                });
              })();
            </script>

            {%- comment -%}Hide shipping estimator for Limit customers{%- endcomment -%}
            {%- if section.settings.show_shipping_estimator and items_requiring_shipping.size > 0 and is_limited_customer == false -%}
              <div class="shipping-estimator">
                <button type="button" is="toggle-button" class="shipping-estimator__toggle-button collapsible-toggle heading heading--small" aria-controls="shipping-estimator" aria-expanded="false">
                  {{- 'cart.shipping_estimator.estimate_shipping' | t -}}
                  {%- render 'icon' with 'chevron' -%}
                </button>

                <collapsible-content id="shipping-estimator" class="collapsible">
                  <shipping-estimator class="shipping-estimator__form" role="form">
                    <div class="input-row">
                      <div class="input">
                        <label class="input__block-label" for="shipping-estimator[country]">{{ 'cart.shipping_estimator.country' | t }}</label>
                        <div class="select-wrapper">
                          <select class="select" is="country-selector" name="shipping-estimator[country]" id="shipping-estimator[country]" aria-owns="shipping-estimator-province-wrapper" {% if customer and customer.default_address %}data-default="{{ customer.default_address.country }}"{% else %}data-default="{{ section.settings.shipping_estimator_default_country }}"{% endif %}>{{ country_option_tags }}</select>
                          {%- render 'icon' with 'chevron' -%}
                        </div>
                      </div>

                      <div id="shipping-estimator-province-wrapper" class="input" hidden>
                        <label class="input__block-label" for="shipping-estimator[province]">{{ 'cart.shipping_estimator.province' | t }}</label>
                        <div class="select-wrapper">
                          <select class="select" name="shipping-estimator[province]" id="shipping-estimator[province]" {% if customer and customer.default_address %}data-default="{{ customer.default_address.province }}"{% endif %}></select>
                          {%- render 'icon' with 'chevron' -%}
                        </div>
                      </div>

                      <div class="input">
                        <label class="input__block-label" for="shipping-estimator[zip]">{{ 'cart.shipping_estimator.zip_code' | t }}</label>
                        <input type="text" class="input__field" name="shipping-estimator[zip]" id="shipping-estimator[zip]">
                      </div>
                    </div>

                    <button type="button" is="loader-button" class="form__submit form__submit--closer button button--primary">{{ 'cart.shipping_estimator.submit' | t }}</button>
                  </shipping-estimator>
                </collapsible-content>
              </div>
            {%- endif -%}
          </div>

          <div class="cart__aside">
            <safe-sticky offset="24" class="cart__aside-inner">
              <form action="{{ routes.cart_url }}" method="post" novalidate class="cart__recap">
                {%- unless is_limited_customer -%}
                <input type="hidden" name="checkout">
                {%- endunless -%}

                {%- for block in section.blocks -%}
                  {%- case block.type -%}
                    {%- when 'totals' -%}
                      <div class="cart__recap-block" {{ block.shopify_attributes }}>
                        <div class="cart__total-container">
                          <span class="heading h6">{{ 'cart.general.total' | t }}</span>
                          <span class="heading h6">{{ cart.total_price | money_with_currency }}</span>
                        </div>

                        {%- if cart.cart_level_discount_applications != blank -%}
                          <ul class="cart__discount-list list--unstyled" role="list">
                            {%- for discount_application in cart.cart_level_discount_applications -%}
                              <li class="cart__discount">
                                <span class="cart__discount-badge discount-badge">{%- render 'icon' with 'discount-badge' -%}{{ discount_application.title }}</span>
                                <span class="cart__discount-price">-{{ discount_application.total_allocated_amount | money }}</span>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}

                        {%- capture shipping_tax_note -%}{{ 'cart.general.shipping_tax_note_html' | t: link: shop.shipping_policy.url }}{%- endcapture -%}

                        {%- if shipping_tax_note != '' -%}
                          <p class="cart__tax-note text--subdued">{{ shipping_tax_note }}</p>
                        {%- endif -%}
                      </div>

                    {%- when 'order_note' -%}
                      <div class="cart__recap-note" {{ block.shopify_attributes }}>
                        <button type="button" is="toggle-button" id="order-note-toggle" class="link text--subdued" aria-controls="cart-note" aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}">
                          {%- if cart.note == '' -%}
                            {{- 'cart.general.add_order_note' | t -}}
                          {%- else -%}
                            {{- 'cart.general.edit_order_note' | t -}}
                          {%- endif -%}
                        </button>

                        <collapsible-content id="cart-note" class="collapsible" {% if block.settings.open_by_default %}open{% endif %}>
                          <div class="cart__order-note">
                            <textarea is="cart-note" aria-owns="order-note-toggle" name="note" class="input__field input__field--textarea" rows="3" placeholder="{{ 'cart.general.order_note_placeholder' | t }}" aria-label="{{ 'cart.general.order_note' | t | escape }}">{{ cart.note }}</textarea>
                          </div>
                        </collapsible-content>
                      </div>

                    {%- when 'express_checkout_buttons' -%}
                      {%- comment -%}Hidden for limited/Akima/Manager+Extended; for TH customers it renders hidden and JS reveals it when the location allows card.{%- endcomment -%}
                      {%- if card_default_shown or has_target_tag -%}
                        {%- if additional_checkout_buttons -%}
                          <div class="cart__recap-block{% unless card_default_shown %} th-card-gated{% endunless %}"{% unless card_default_shown %} style="display: none;"{% endunless %} {{ block.shopify_attributes }}>
                            <div class="additional-checkout-buttons additional-checkout-buttons--vertical">
                              {{- content_for_additional_checkout_buttons -}}
                            </div>
                          </div>
                        {%- endif -%}
                      {%- endif -%}

                    {%- when '@app' -%}
                      <div class="cart__recap-block">
                        {%- render block -%}
                      </div>
                  {%- endcase -%}
                {%- endfor -%}

                {%- if card_default_shown or has_target_tag -%}
                <button type="submit" class="cart__checkout-button checkout-button button button--primary button--full{% unless card_default_shown %} th-card-gated{% endunless %}"{% unless card_default_shown %} style="display: none;"{% endunless %} name="checkout">
                  <span class="checkout-button__lock">{%- render 'icon' with 'lock' -%}</span>
                  Pay Now
                </button>
                {%- endif -%}

                {%- comment -%}Pay Later Button - Shows as "Place Order" for Limit customers, primary for Manager+Extended{%- endcomment -%}
                <button type="button" id="pay-later-btn" class="cart__pay-later-button button button--full{% if is_limited_customer or has_akima_tag or is_manager_extended %} cart__pay-later-button--primary{% endif %}">
                  {% if is_limited_customer %}Place Order{% elsif has_akima_tag or is_manager_extended %}Pay Later{% else %}Pay Later{% endif %}
                </button>

                <style>
                  .cart__pay-later-button {
                    margin-top: 1rem;
                    background-color: #ac262c;
                    color: white;
                    border: none;
                  }

                  .cart__pay-later-button:hover {
                    background-color: #8b1f24;
                  }

                  /* When Pay Later is the only button (for limited customers) */
                  .cart__pay-later-button--primary {
                    margin-top: 0;
                  }
                </style>
              </form>

              {%- comment -%}Hidden for limited/Akima/Manager+Extended; for TH customers it renders hidden and JS reveals it when the location allows card.{%- endcomment -%}
              {%- if card_default_shown or has_target_tag -%}
                {%- if section.settings.show_payment_methods and shop.enabled_payment_types.size > 0 -%}
                  <div class="cart__payment-methods{% unless card_default_shown %} th-card-gated{% endunless %}"{% unless card_default_shown %} style="display: none;"{% endunless %}>
                    <span class="cart__payment-methods-label text--xsmall text--subdued">{{ 'cart.general.we_accept' | t }}</span>

                    <div class="payment-methods-list payment-methods-list--center">
                      {% for type in shop.enabled_payment_types %}
                        {{ type | payment_type_svg_tag }}
                      {% endfor %}
                    </div>
                  </div>
                {%- endif -%}
              {%- endif -%}
            </safe-sticky>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%}Pay Later Modal{%- endcomment -%}
