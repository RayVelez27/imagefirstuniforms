      <div class="pay-later-submit-section">
        <button type="submit" class="button button--primary button--full">{% if is_limited_customer %}Submit Order{% else %}Submit Pay Later Request{% endif %}</button>
        <div id="pay-later-message"></div>
      </div>
    </form>
  </div>
</div>

