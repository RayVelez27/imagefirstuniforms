{%- comment -%}
  Password Gate (client-side / "faux" protection)

  Renders a blank page with a single password field. When the visitor enters the
  correct password, a per-session flag is stored in sessionStorage and they are
  redirected to the protected collection. The matching collection template
  (collection.gated.liquid) checks for the same flag and redirects anyone who
  did not come through this gate back here.

  NOTE: This is client-side only. The password is visible in page source and the
  collection URL is public. It is a speed bump, not real security. For true
  gating, use customer tags / B2B access (see collection.liquid for examples).
{%- endcomment -%}

{%- liquid
  assign storage_key = 'akima-store-gate'
  assign storage_value = 'granted'
-%}

<section class="password-gate">
  <div class="password-gate__inner">
    {%- if section.settings.heading != blank -%}
      <h1 class="password-gate__heading heading h3">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="password-gate__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <form class="password-gate__form" id="PasswordGateForm" autocomplete="off" novalidate>
      <input
        type="password"
        class="password-gate__input"
        id="PasswordGateInput"
        name="gate_password"
        placeholder="{{ section.settings.placeholder | escape }}"
        aria-label="{{ section.settings.placeholder | escape }}"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        required
      >

      <button type="submit" class="password-gate__button button button--primary">
        {{ section.settings.button_text | escape }}
      </button>

      <p class="password-gate__error" id="PasswordGateError" role="alert" hidden>
        {{ section.settings.error_text | escape }}
      </p>
    </form>
  </div>
</section>

<script>
  (function () {
    var form = document.getElementById('PasswordGateForm');
    if (!form) return;

    var input = document.getElementById('PasswordGateInput');
    var error = document.getElementById('PasswordGateError');

    var PASSWORD = {{ section.settings.password | json }};
    var REDIRECT = {{ section.settings.redirect_url | json }};
    var KEY = {{ storage_key | json }};
    var VALUE = {{ storage_value | json }};

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      if (input.value === PASSWORD) {
        try { sessionStorage.setItem(KEY, VALUE); } catch (e) {}
        window.location.href = REDIRECT;
      } else {
        if (error) error.hidden = false;
        input.value = '';
        input.focus();
      }
    });

    input.addEventListener('input', function () {
      if (error) error.hidden = true;
    });
  })();
</script>

<style>
  .password-gate {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    padding: 40px 20px;
  }

  .password-gate__inner {
    width: 100%;
    max-width: 380px;
    text-align: center;
  }

  .password-gate__heading {
    margin: 0 0 12px;
  }

  .password-gate__subheading {
    margin: 0 0 28px;
    color: rgba(var(--text-color), 0.75);
  }

  .password-gate__form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .password-gate__input {
    width: 100%;
    padding: 14px 16px;
    font-size: 16px;
    border: 1px solid rgba(var(--text-color), 0.2);
    border-radius: var(--button-border-radius, 0);
    background: rgb(var(--background));
    color: rgb(var(--text-color));
    text-align: center;
  }

  .password-gate__input:focus {
    outline: none;
    border-color: rgba(var(--text-color), 0.5);
  }

  .password-gate__button {
    width: 100%;
  }

  .password-gate__error {
    margin: 4px 0 0;
    font-size: 14px;
    color: rgb(var(--error-color, 224 0 0));
  }
</style>

{% schema %}
{
  "name": "Password gate",
  "class": "shopify-section--password-gate",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Enter password"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Please enter the password to continue."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Password"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Continue"
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Error message",
      "default": "Incorrect password. Please try again."
    },
    {
      "type": "header",
      "content": "Access settings"
    },
    {
      "type": "text",
      "id": "password",
      "label": "Password",
      "info": "Visible in page source — do not use a sensitive password here.",
      "default": "Uniforms2026!"
    },
    {
      "type": "text",
      "id": "redirect_url",
      "label": "Redirect to (on success)",
      "info": "The protected collection path. Must use the gated collection template.",
      "default": "/collections/akima-store"
    }
  ],
  "presets": [
    {
      "name": "Password gate"
    }
  ]
}
{% endschema %}
