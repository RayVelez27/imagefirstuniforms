{%- comment -%}
  Akima Location Page
  Shows collection links to Akima customers (tagged with "Akima" + "Limit")
  based on their location tag (e.g. "Five Rivers", "Chrome SPC").
{%- endcomment -%}

{%- assign has_akima_tag = false -%}
{%- assign has_limit_tag = false -%}
{%- assign akima_location = nil -%}

{%- if customer -%}
  {%- for tag in customer.tags -%}
    {%- assign tag_lower = tag | downcase | strip -%}
    {%- if tag_lower == 'akima' -%}
      {%- assign has_akima_tag = true -%}
    {%- endif -%}
    {%- if tag_lower == 'limit' -%}
      {%- assign has_limit_tag = true -%}
    {%- endif -%}
    {%- if tag_lower == 'five rivers' -%}
      {%- assign akima_location = 'five-rivers' -%}
    {%- endif -%}
    {%- if tag_lower == 'chrome spc' -%}
      {%- assign akima_location = 'chrome-spc' -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign is_akima_limit_user = false -%}
{%- if has_akima_tag and has_limit_tag -%}
  {%- assign is_akima_limit_user = true -%}
{%- endif -%}

<section>
  <div class="container">
    {%- if is_akima_limit_user -%}
      <header class="page-header">
        <div class="page-header__text-wrapper">
          <h1 class="heading h2">Your Collections</h1>
        </div>
      </header>

      <div class="page-content page-content--large">
        {%- if akima_location == 'five-rivers' -%}
          {%- comment -%} Five Rivers location: show Five Rivers Analytics collection {%- endcomment -%}
          <div class="akima-collections">
            <a href="/collections/akima-five-rivers-analytics" class="akima-collection-card">
              <div class="akima-collection-card__content">
                <h2 class="heading h4">Five Rivers Analytics</h2>
                <span class="akima-collection-card__cta">Shop Now &rarr;</span>
              </div>
            </a>
          </div>

        {%- elsif akima_location == 'chrome-spc' -%}
          {%- comment -%} Chrome SPC location: show Akima collection {%- endcomment -%}
          <div class="akima-collections">
            <a href="/collections/akima" class="akima-collection-card">
              <div class="akima-collection-card__content">
                <h2 class="heading h4">Chrome SPC</h2>
                <span class="akima-collection-card__cta">Shop Now &rarr;</span>
              </div>
            </a>
          </div>

        {%- else -%}
          {%- comment -%} No recognized location tag — show all available collections {%- endcomment -%}
          <div class="akima-collections">
            <a href="/collections/akima-five-rivers-analytics" class="akima-collection-card">
              <div class="akima-collection-card__content">
                <h2 class="heading h4">Five Rivers Analytics</h2>
                <span class="akima-collection-card__cta">Shop Now &rarr;</span>
              </div>
            </a>
            <a href="/collections/akima" class="akima-collection-card">
              <div class="akima-collection-card__content">
                <h2 class="heading h4">Chrome SPC</h2>
                <span class="akima-collection-card__cta">Shop Now &rarr;</span>
              </div>
            </a>
          </div>
        {%- endif -%}
      </div>

    {%- else -%}
      <div class="empty-state text-container">
        <h1 class="heading h1">Access Restricted</h1>
        <p class="text--large">You do not have permission to view this page.</p>
        <div class="button-wrapper">
          <a href="{{ routes.root_url }}" class="button button--primary">Back to Home</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .akima-collections {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
    margin-top: 20px;
  }

  .akima-collection-card {
    display: block;
    border: 1px solid rgba(var(--text-color), 0.12);
    border-radius: 4px;
    padding: 40px 30px;
    text-decoration: none;
    color: rgb(var(--text-color));
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .akima-collection-card:hover {
    border-color: rgba(var(--text-color), 0.3);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }

  .akima-collection-card__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .akima-collection-card__cta {
    font-size: 14px;
    opacity: 0.7;
  }

  .akima-collection-card:hover .akima-collection-card__cta {
    opacity: 1;
  }
</style>

{% schema %}
{
  "name": "Akima Locations",
  "class": "shopify-section--main-page-akima"
}
{% endschema %}
