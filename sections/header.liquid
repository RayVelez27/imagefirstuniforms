      headerHeight = headerElement.clientHeight,
      headerHeightWithoutBottomNav = headerElement.querySelector('.header__wrapper').clientHeight;

    document.documentElement.style.setProperty('--header-height', headerHeight + 'px');
    document.documentElement.style.setProperty('--header-height-without-bottom-nav', headerHeightWithoutBottomNav + 'px');
  })();
</script>

{%- comment -%}
  Akima Store mode: point the logo at the Akima Store collection.

  The logo is server-rendered with href="{{ routes.root_url }}" (the site root),
  but the root route now ends the Akima session (see snippets/akima-store-mode.liquid).
  So while a gated visitor is in Akima Store mode, rewrite the logo link to the
  Akima Store collection ("home") so clicking it keeps them in the store instead
  of killing the session. Client-side only — see notes in sections/password-gate.liquid.

  Skipped on the gate page itself (/pages/akima-store): there the logo must always
  point back to the gate (set server-side above), so we don't rewrite it here.
{%- endcomment -%}
{%- unless is_akima_gate -%}
<script>
  (function () {
    try {
      if (sessionStorage.getItem('akima-store-gate') !== 'granted') return;
      var logoLink = document.querySelector('.header__logo-link');
      if (logoLink) logoLink.setAttribute('href', '/collections/akima-store');
    } catch (e) {}
  })();
</script>
{%- endunless -%}

{%- comment -%}
  Akima Store mode: "Exit store" button handler (only present on the akima-store
  collection page). Clears the gate session flag and the saved order mode, removes
  the cart's Akima Store marker, then returns the visitor to the password gate.
  Moved here from the old top session bar. Client-side only — see notes in
  sections/password-gate.liquid.
{%- endcomment -%}
<script>
  (function () {
    var btn = document.getElementById('AkimaStoreExit');
    if (!btn) return;

    btn.addEventListener('click', function () {
      try {
        sessionStorage.removeItem('akima-store-gate');
        sessionStorage.removeItem('orderMode');
        sessionStorage.removeItem('akima-cart-tagged');
      } catch (e) {}

      // Clear the Akima Store marker from the cart (empty value removes the
      // attribute) so a later non-gated order isn't tagged, then return to the gate.
      fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ attributes: { '_akima_store': '' } })
      }).catch(function () {}).then(function () {
        window.location.href = '/pages/akima-store';
      });
    });
  })();
</script>

<script type="application/ld+json">
